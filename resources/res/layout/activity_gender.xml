<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_actionbar"
        android:background="@color/actionbarColor"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_30sdp">
        <ImageView
            android:id="@+id/iv_back"
            android:padding="5dp"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_marginLeft="@dimen/dp10"
            android:src="@drawable/ic_back"
            android:layout_alignParentLeft="true"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/dp10"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/_10sdp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update Gender"
            android:layout_centerInParent="true"
            android:textAllCaps="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_5sdp">
        <TextView
            android:textSize="@dimen/_12sdp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:id="@+id/tv_heading_cnic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enter_your_cnic"
            android:textAlignment="center"/>
        <TextView
            android:textSize="@dimen/_12sdp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:id="@+id/tv_app_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp15"
            android:text="@string/enter_your_cnic_urdu"
            android:fontFamily="@font/jameel_noori_nastaleeq"
            android:textAlignment="center"/>
        <EditText
            android:textSize="@dimen/textview_text_size"
            android:textColor="@color/black"
            android:textColorHint="@color/hintColor"
            android:gravity="start|center_vertical"
            android:id="@+id/et_cnic"
            android:background="@drawable/edit_text_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            android:hint="_____-_______-_"
            android:maxLines="1"
            android:maxLength="13"
            android:digits="0123456789"
            android:inputType="number"
            android:paddingStart="@dimen/dp10"
            android:paddingEnd="@dimen/dp10"
            android:layout_marginStart="@dimen/dp10"
            android:layout_marginEnd="@dimen/dp10"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp20"
            android:layout_marginStart="@dimen/dp10"
            android:layout_marginEnd="@dimen/dp10">
            <TextView
                android:textSize="@dimen/_12sdp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_gravity="center_vertical"
                android:paddingRight="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NSER Gender"/>
            <TextView
                android:textSize="@dimen/_12sdp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_nser_gender"
                android:paddingRight="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gender"
                android:fontFamily="@font/jameel_noori_nastaleeq"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:weightSum="1">
            <RadioGroup
                android:orientation="horizontal"
                android:id="@+id/rg_gender"
                android:paddingRight="20dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8">
                <RadioButton
                    android:textSize="@dimen/_12sdp"
                    android:id="@+id/rb_male"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:text="@string/male"
                    android:fontFamily="@font/jameel_noori_nastaleeq"
                    android:buttonTint="@color/colorButtonGreen"/>
                <RadioButton
                    android:textSize="@dimen/_12sdp"
                    android:id="@+id/rb_female"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:text="@string/female"
                    android:fontFamily="@font/jameel_noori_nastaleeq"
                    android:buttonTint="@color/colorButtonRed"/>
                <RadioButton
                    android:textSize="@dimen/_12sdp"
                    android:id="@+id/rb_trans_gender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:text="@string/transgender"
                    android:fontFamily="@font/jameel_noori_nastaleeq"
                    android:buttonTint="@color/colorButtonYellow"/>
            </RadioGroup>
            <TextView
                android:textSize="@dimen/_12sdp"
                android:layout_gravity="center_vertical"
                android:paddingRight="20dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/gender"
                android:layout_weight="0.2"
                android:fontFamily="@font/jameel_noori_nastaleeq"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp30">
            <TextView
                android:textSize="@dimen/subheading_text_size"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/btn_update"
                android:background="@drawable/login_button_bk"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp60"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Update"
                android:layout_below="@+id/ll_spinner"
                android:layout_marginStart="@dimen/dp30"
                android:layout_marginEnd="@dimen/dp30"/>
            <TextView
                android:textSize="@dimen/subheading_text_size"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/btn_validate"
                android:background="@drawable/login_button_bk"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp60"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="Validate"
                android:layout_below="@+id/ll_spinner"
                android:layout_marginStart="@dimen/dp30"
                android:layout_marginEnd="@dimen/dp30"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textColor="@color/black"
        android:layout_gravity="center"
        android:id="@+id/application_version_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_10sdp"
        android:text="App Version: "/>
</LinearLayout>
