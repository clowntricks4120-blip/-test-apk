<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="@dimen/heading_text_size"
            android:textColor="@android:color/white"
            android:gravity="center_horizontal"
            android:id="@+id/tv_title"
            android:background="@color/colorPrimary"
            android:padding="@dimen/header_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingTop="@dimen/activity_vertical_margin"
            android:paddingRight="@dimen/activity_horizontal_margin"
            android:paddingBottom="@dimen/activity_vertical_margin"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/ll_thumb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp">
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp">
                        <Button
                            android:gravity="center"
                            android:id="@+id/btn_take_pic_thumb"
                            android:background="@drawable/btn_selector_thumb"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="10dp"
                            android:text="Respondant picture"
                            android:drawableLeft="@android:drawable/ic_menu_camera"
                            android:drawablePadding="10dp"
                            android:drawableStart="@android:drawable/ic_menu_camera"
                            style="@style/buttonStyle"/>
                        <Button
                            android:gravity="center"
                            android:id="@+id/btn_take_thumb_imp"
                            android:background="@drawable/btn_selector_thumb"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="10dp"
                            android:text="Thumb Scan"
                            android:drawableLeft="@android:drawable/ic_menu_camera"
                            android:drawablePadding="10dp"
                            android:drawableStart="@android:drawable/ic_menu_camera"
                            style="@style/buttonStyle"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="@dimen/enumerator_row_size"
                        android:textColor="@color/colorPrimary"
                        android:gravity="center_horizontal"
                        android:padding="@dimen/header_padding"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/thumb_des"/>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp">
                        <ImageView
                            android:id="@+id/imgbtn_beneficiary"
                            android:visibility="gone"
                            android:layout_width="@dimen/image_dimension"
                            android:layout_height="@dimen/image_dimension"
                            android:layout_margin="10dp"
                            android:scaleType="fitCenter"
                            android:adjustViewBounds="true"/>
                        <ImageView
                            android:id="@+id/thumb_img"
                            android:layout_width="@dimen/image_dimension"
                            android:layout_height="@dimen/image_dimension"
                            android:layout_margin="10dp"
                            android:scaleType="fitCenter"
                            android:adjustViewBounds="true"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/ll_selfie"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp">
                    <Button
                        android:gravity="center"
                        android:id="@+id/btn_take_pic_selfie"
                        android:background="@drawable/btn_selector_selfie"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="5dp"
                        android:text="@string/enum_selfie"
                        android:drawableLeft="@android:drawable/ic_menu_camera"
                        android:drawablePadding="10dp"
                        android:drawableStart="@android:drawable/ic_menu_camera"
                        style="@style/buttonStyle"/>
                    <ImageView
                        android:id="@+id/imgbtn_selfie"
                        android:visibility="invisible"
                        android:layout_width="@dimen/image_dimension"
                        android:layout_height="@dimen/image_dimension"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/textview_text_size"
                android:id="@+id/tv_form_no"
                android:paddingLeft="5dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/fields_margin"
                android:hint="Form No :"
                android:inputType="text"
                android:imeOptions="actionNext"/>
            <TextView
                android:textSize="@dimen/textview_text_size"
                android:id="@+id/form_no"
                android:background="@drawable/edit_text_bg"
                android:paddingLeft="5dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/fields_margin"
                android:hint="Form No"
                android:inputType="text"
                android:imeOptions="actionNext"/>
            <Button
                android:textSize="@dimen/textview_text_size"
                android:textColor="@android:color/white"
                android:id="@+id/btn_qr_code"
                android:background="@color/colorPrimary"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="SCAN QR CODE"
                android:textAlignment="center"/>
            <Button
                android:textSize="@dimen/textview_text_size"
                android:textColor="@android:color/white"
                android:id="@+id/btn_generate_code"
                android:background="@color/colorButtonGreen"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="GENERATE RANDOM NUMBER"
                android:textAlignment="center"/>
            <CheckBox
                android:textSize="@dimen/heading_text_size"
                android:id="@+id/cb_recollection"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="@dimen/fields_margin"
                android:text="Re-collecting survey"
                android:textAlignment="center"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_old_qr_code"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/textview_text_size"
                    android:id="@+id/form_no_old"
                    android:background="@drawable/edit_text_bg"
                    android:paddingLeft="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/fields_margin"
                    android:hint="Old Survey Number"
                    android:inputType="text"
                    android:imeOptions="actionNext"/>
                <TextView
                    android:textSize="@dimen/textview_text_size"
                    android:id="@+id/form_no_renter_old"
                    android:background="@drawable/edit_text_bg"
                    android:paddingLeft="5dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/fields_margin"
                    android:hint="Re-enter Old Survey Number"
                    android:inputType="text"
                    android:imeOptions="actionDone"/>
                <Button
                    android:textSize="@dimen/textview_text_size"
                    android:textColor="@android:color/white"
                    android:id="@+id/btn_qr_code_old"
                    android:background="@color/colorPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="SCAN OLD QR CODE"
                    android:textAlignment="center"/>
                <CheckBox
                    android:textSize="@dimen/heading_text_size"
                    android:id="@+id/cb_old_recipient"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Is Old Receipt Not Available"
                    android:textAlignment="center"/>
            </LinearLayout>
            <EditText
                android:textAppearance="@style/Base.TextAppearance.AppCompat.Medium"
                android:gravity="top|left"
                android:id="@+id/et_comments"
                android:background="@drawable/edit_text_bg"
                android:paddingLeft="5dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Comments"
                android:maxLines="3"
                android:minLines="3"
                android:maxLength="500"
                android:digits="@string/digits"/>
            <CheckBox
                android:textSize="@dimen/heading_text_size"
                android:id="@+id/cb_is_multistory"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Is this multistory or a compound?"
                android:textAlignment="center"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
