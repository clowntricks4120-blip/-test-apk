<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/backgroundColor"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_actionbar"
        android:background="@color/actionbarColor"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_30sdp">
        <ImageView
            android:id="@+id/iv_back"
            android:padding="5dp"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_marginLeft="@dimen/dp10"
            android:src="@drawable/ic_back"
            android:layout_alignParentLeft="true"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/dp10"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/_10sdp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/roster_list_heading"
            android:layout_centerInParent="true"
            android:textAllCaps="true"/>
        <TextView
            android:textSize="@dimen/_10sdp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_add"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="match_parent"
            android:text="ADD"
            android:layout_centerInParent="true"
            android:textAllCaps="true"
            android:layout_marginEnd="@dimen/_15sdp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/cb_is_bisp_benif"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_9sdp"
        android:layout_below="@+id/rl_actionbar">
        <TextView
            android:textSize="@dimen/_11sdp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/question_bisp_benificiary_roster"
            android:layout_centerInParent="true"
            android:fontFamily="@font/jameel_noori_nastaleeq"
            android:layout_toStartOf="@+id/tv_benif"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="@dimen/_13sdp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/tv_benif"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/yes"
            android:fontFamily="@font/jameel_noori_nastaleeq"/>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/_9sdp"
        android:layout_above="@+id/btn_save"
        android:layout_below="@+id/cb_is_bisp_benif"
        app:reverseLayout="true"
        app:stackFromEnd="true"/>
    <Button
        android:textSize="@dimen/textview_text_size"
        android:textColor="@android:color/white"
        android:id="@+id/btn_save"
        android:background="@drawable/btn_selector_roster"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:text="Finish"
        android:layout_alignParentBottom="true"
        android:textAlignment="center"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"/>
    <TextView
        android:textColor="@color/black"
        android:id="@+id/application_version_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_10sdp"
        android:text="App Version: "
        android:layout_alignParentBottom="true"
        android:layout_centerInParent="true"/>
</RelativeLayout>
