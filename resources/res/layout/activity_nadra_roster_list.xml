<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/backgroundColor"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_actionbar"
        android:background="@color/actionbarColor"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_30sdp">
        <ImageView
            android:id="@+id/iv_back"
            android:padding="5dp"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_marginLeft="@dimen/dp10"
            android:src="@drawable/ic_back"
            android:layout_alignParentLeft="true"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/dp10"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/_10sdp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/roster_list_heading"
            android:layout_centerInParent="true"
            android:textAllCaps="true"/>
        <TextView
            android:textSize="@dimen/_10sdp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_add"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="match_parent"
            android:text="ADD"
            android:layout_centerInParent="true"
            android:textAllCaps="true"
            android:layout_marginEnd="@dimen/_15sdp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/heading_text_size"
        android:gravity="right"
        android:id="@+id/tv_time_remaining"
        android:padding="@dimen/header_padding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Time Remaining : 0"
        android:layout_below="@+id/rl_actionbar"/>
    <TextView
        android:textSize="@dimen/heading_text_size"
        android:textStyle="bold"
        android:id="@+id/tv_clear_log"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="Clear Log"
        android:layout_toRightOf="@+id/tv_time_remaining"
        android:layout_below="@+id/rl_actionbar"/>
    <TextView
        android:textSize="@dimen/_12sdp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/tv_heading_"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_9sdp"
        android:layout_marginBottom="@dimen/_9sdp"
        android:text="Select roster you want to add"
        android:maxLines="1"
        android:layout_below="@+id/tv_time_remaining"
        android:layout_marginStart="@dimen/_9sdp"
        android:layout_marginEnd="@dimen/_9sdp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/_9sdp"
        android:layout_marginBottom="@dimen/_9sdp"
        android:layout_below="@+id/tv_heading_"
        android:layout_marginStart="@dimen/_9sdp"
        android:layout_marginEnd="@dimen/_9sdp"
        app:reverseLayout="true"
        app:stackFromEnd="true"/>
    <TextView
        android:textColor="@color/black"
        android:id="@+id/application_version_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_10sdp"
        android:text="App Version: "
        android:layout_alignParentBottom="true"
        android:layout_centerInParent="true"/>
</RelativeLayout>
