<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_fields"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/textview_text_size"
                android:textStyle="bold"
                android:gravity="center_horizontal"
                android:id="@+id/tv_ref_no"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="@dimen/textview_text_size"
                android:textStyle="bold"
                android:gravity="center_horizontal"
                android:id="@+id/tv_sub_locality"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/textview_text_size"
            android:textStyle="bold"
            android:gravity="center_horizontal"
            android:id="@+id/tv_enum_interview_status"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No one at home"
            android:layout_below="@+id/ll_fields"/>
        <Spinner
            android:id="@+id/sp_visit_status"
            android:background="@drawable/spinner_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_marginBottom="5dp"
            android:layout_below="@+id/tv_enum_interview_status"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_member_layout"
            android:paddingTop="10dp"
            android:paddingRight="5dp"
            android:paddingBottom="5dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:layout_below="@+id/sp_visit_status">
            <TextView
                android:textSize="@dimen/textview_text_size"
                android:paddingBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/number_of_roster"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:textSize="@dimen/textview_text_size"
                    android:id="@+id/number_of_roster"
                    android:background="@drawable/edit_text_bg"
                    android:paddingLeft="@dimen/text_padding"
                    android:paddingRight="@dimen/text_padding"
                    android:focusable="false"
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:text="1"
                    android:hint="@string/number_of_roster"
                    android:maxLength="3"
                    android:digits="@string/digits"
                    android:layout_weight="1"
                    android:inputType="none"/>
                <ImageView
                    android:id="@+id/iv_add_member"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_margin="5dp"
                    android:src="@drawable/ic_add"/>
                <ImageView
                    android:id="@+id/iv_delete_member"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_margin="5dp"
                    android:src="@drawable/ic_minus"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/textview_text_size"
            android:textColor="#000000"
            android:id="@+id/tv_current_respondant"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_below="@+id/ll_member_layout"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_resp_detail"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_below="@+id/tv_current_respondant">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/textview_text_size"
                    android:id="@+id/tv_resp_question"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <View
                    android:layout_width="20dp"
                    android:layout_height="1dp"/>
                <RadioGroup
                    android:orientation="horizontal"
                    android:id="@+id/rg_is_resp_avail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <RadioButton
                        android:textSize="@dimen/textview_text_size"
                        android:id="@+id/rb_resp_avail_yes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/yes"
                        android:buttonTint="@color/colorButtonGreen"/>
                    <RadioButton
                        android:textSize="@dimen/textview_text_size"
                        android:id="@+id/rb_resp_avail_no"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/no"
                        android:buttonTint="@color/colorButtonRed"/>
                </RadioGroup>
            </LinearLayout>
            <Spinner
                android:id="@+id/sp_select_resp"
                android:background="@drawable/spinner_bg"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:layout_marginBottom="5dp"/>
        </LinearLayout>
        <Button
            android:textSize="@dimen/textview_text_size"
            android:textColor="@android:color/white"
            android:id="@+id/btn_done"
            android:tag="3"
            android:background="@color/colorButtonRed"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingTop="@dimen/activity_vertical_margin"
            android:paddingRight="@dimen/activity_horizontal_margin"
            android:paddingBottom="@dimen/activity_vertical_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:text="Next"
            android:layout_below="@+id/ll_resp_detail"/>
    </RelativeLayout>
</RelativeLayout>
