<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/colorCardRoster">
    <LinearLayout
        android:orientation="horizontal"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/textview_text_size"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/tv_roster_relational_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:text="23"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/textview_text_size"
                android:textColor="@android:color/white"
                android:id="@+id/person_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Haider Saddique"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"/>
            <TextView
                android:textSize="@dimen/textview_text_size"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/person_relation_to_household"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Father"
                android:layout_below="@+id/person_name"
                android:layout_alignParentLeft="true"/>
            <TextView
                android:textSize="@dimen/textview_text_size"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/tv_block_no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:layout_below="@+id/person_relation_to_household"
                android:layout_alignParentLeft="true"/>
            <TextView
                android:textSize="@dimen/textview_text_size"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/tv_ea_no"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:layout_below="@+id/tv_block_no"
                android:layout_alignParentLeft="true"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_cnic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_below="@+id/tv_ea_no">
                <RadioGroup
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/rg_cnic_option"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">
                    <RadioButton
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/rb_not_made"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="1dp"
                        android:checked="false"
                        android:text="@string/cnic_not_made"
                        android:layout_weight="0.33"
                        android:buttonTint="@color/colorButtonRed"/>
                    <RadioButton
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/rb_absent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="1dp"
                        android:checked="false"
                        android:text="@string/cnic_absent"
                        android:layout_weight="0.33"
                        android:buttonTint="@color/colorButtonRed"/>
                    <RadioButton
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/rb_present"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="1dp"
                        android:checked="false"
                        android:text="@string/cnic_present"
                        android:layout_weight="0.33"
                        android:buttonTint="@color/colorButtonGreen"/>
                </RadioGroup>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
