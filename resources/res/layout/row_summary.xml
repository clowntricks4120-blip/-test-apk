<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    app:cardBackgroundColor="@color/cropCVBg">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="@style/Base.TextAppearance.AppCompat.Small"
            android:gravity="center"
            android:id="@+id/tv_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="2018-07-09"
            android:layout_weight="0.15"/>
        <TextView
            android:textAppearance="@style/Base.TextAppearance.AppCompat.Small"
            android:gravity="center"
            android:id="@+id/tv_locality"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Lahore"
            android:layout_weight="0.2"/>
        <TextView
            android:textAppearance="@style/Base.TextAppearance.AppCompat.Small"
            android:gravity="center"
            android:id="@+id/tv_supervisor_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Supervisor\10TimeStamp"
            android:layout_weight="0.15"/>
        <TextView
            android:textAppearance="@style/Base.TextAppearance.AppCompat.Small"
            android:gravity="center"
            android:id="@+id/tv_total_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Total\10Surveys"
            android:layout_weight="0.17"/>
        <TextView
            android:textAppearance="@style/Base.TextAppearance.AppCompat.Small"
            android:gravity="center"
            android:id="@+id/tv_declined_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Not at Home\10Survey"
            android:layout_weight="0.16"/>
        <TextView
            android:textAppearance="@style/Base.TextAppearance.AppCompat.Small"
            android:gravity="center"
            android:id="@+id/tv_not_at_home_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Declined\10Surveys"
            android:layout_weight="0.17"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
