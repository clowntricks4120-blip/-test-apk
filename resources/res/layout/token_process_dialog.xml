<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/subheading_text_size"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:id="@+id/tv_heading_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enter_your_token_number"
            android:textAlignment="center"/>
        <TextView
            android:textSize="@dimen/subheading_text_size"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:id="@+id/tv_app_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp15"
            android:text="@string/enter_your_token_urdu"
            android:fontFamily="@font/jameel_noori_nastaleeq"
            android:textAlignment="center"/>
        <TextView
            android:textSize="@dimen/_12sdp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:id="@+id/tv_token_cnic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            android:textAlignment="center"/>
        <EditText
            android:textSize="@dimen/textview_text_size"
            android:textColor="@color/black"
            android:textColorHint="@color/hintColor"
            android:gravity="start|center_vertical"
            android:id="@+id/token_number_editText"
            android:background="@drawable/edit_text_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            android:hint="Token Number"
            android:maxLines="1"
            android:maxLength="10"
            android:digits="0123456789"
            android:inputType="number"
            android:paddingStart="@dimen/dp10"
            android:paddingEnd="@dimen/dp10"
            android:layout_marginStart="@dimen/dp10"
            android:layout_marginEnd="@dimen/dp10"/>
        <Button
            android:textSize="@dimen/subheading_text_size"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/process_token_button"
            android:background="@drawable/login_button_bk"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp60"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="Submit"
            android:layout_marginStart="@dimen/dp30"
            android:layout_marginEnd="@dimen/dp30"/>
    </LinearLayout>
</LinearLayout>
