<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:weightSum="5">
    <androidx.cardview.widget.CardView
        android:id="@+id/roster_item_cardView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="4"
        app:cardBackgroundColor="@color/colorCardRoster">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/textview_text_size"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/tv_roster_relational_id"
                android:padding="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <RelativeLayout
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/textview_text_size"
                    android:textColor="@android:color/holo_red_light"
                    android:id="@+id/roster_status"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="* Please complete your roster"
                    android:layout_toLeftOf="@+id/iv_edit"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:layout_toStartOf="@+id/iv_edit"/>
                <TextView
                    android:textSize="@dimen/textview_text_size"
                    android:textColor="@android:color/white"
                    android:id="@+id/person_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toLeftOf="@+id/iv_edit"
                    android:layout_below="@+id/roster_status"
                    android:layout_alignParentLeft="true"
                    android:layout_toStartOf="@+id/iv_edit"/>
                <TextView
                    android:textSize="@dimen/textview_text_size"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:id="@+id/person_relation_to_household"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toLeftOf="@+id/iv_edit"
                    android:layout_below="@+id/person_name"
                    android:layout_alignParentLeft="true"
                    android:layout_toStartOf="@+id/iv_edit"/>
                <TextView
                    android:textSize="@dimen/textview_text_size"
                    android:textColor="@android:color/white"
                    android:id="@+id/person_cnic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toLeftOf="@+id/iv_edit"
                    android:layout_below="@+id/person_relation_to_household"
                    android:layout_alignParentLeft="true"
                    android:layout_toStartOf="@+id/iv_edit"/>
                <ImageView
                    android:id="@+id/iv_delete"
                    android:padding="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:src="@drawable/ic_delete"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
                <ImageView
                    android:id="@+id/iv_edit"
                    android:padding="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:src="@drawable/ic_edit"
                    android:layout_toLeftOf="@+id/iv_delete"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <Button
        android:textColor="@color/white"
        android:layout_gravity="center"
        android:id="@+id/verify_button"
        android:background="@drawable/btn_selector_roster"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:text="Verify"
        android:layout_weight="1"/>
</LinearLayout>
