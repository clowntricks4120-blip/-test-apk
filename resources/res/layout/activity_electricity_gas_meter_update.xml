<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/backgroundColor"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_actionbar"
        android:background="@color/actionbarColor"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_30sdp">
        <ImageView
            android:id="@+id/iv_back"
            android:padding="5dp"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_marginLeft="@dimen/dp10"
            android:src="@drawable/ic_back"
            android:layout_alignParentLeft="true"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/dp10"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/_8sdp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/update_electricity_gas_meter"
            android:layout_centerInParent="true"
            android:textAllCaps="true"/>
        <TextView
            android:textSize="@dimen/_9sdp"
            android:textColor="@color/white"
            android:id="@+id/application_version_textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/_9sdp"
            android:text="App Version: "
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/rl_actionbar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp20">
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/img_edit"
                android:background="@color/count_blue_new"
                android:padding="@dimen/_3sdp"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                android:layout_marginTop="@dimen/_30sdp"
                android:src="@drawable/ic_edit"
                app:tint="@color/white"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/_11sdp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/electricity_ref"
                    android:layout_weight="1"
                    android:textAllCaps="false"/>
                <TextView
                    android:textSize="@dimen/_11sdp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/electricity_ref_urdu"
                    android:layout_weight="1"
                    android:fontFamily="@font/jameel_noori_nastaleeq"
                    android:paddingEnd="10dp"/>
            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:enabled="false"
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/hintColor"
                    android:gravity="start|center_vertical"
                    android:id="@+id/et_electricity_ref"
                    android:background="@drawable/edit_text_bg"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_35sdp"
                    android:layout_marginTop="@dimen/dp5"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:maxLength="18"
                    android:digits="0123456789"
                    android:inputType="number"
                    android:imeOptions="actionNext"
                    android:paddingStart="@dimen/dp10"
                    android:paddingEnd="@dimen/dp10"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp15">
                <TextView
                    android:textSize="@dimen/_11sdp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/gas_ref"
                    android:layout_weight="1"
                    android:textAllCaps="false"/>
                <TextView
                    android:textSize="@dimen/_11sdp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/gas_ref_urdu"
                    android:layout_weight="1"
                    android:fontFamily="@font/jameel_noori_nastaleeq"
                    android:paddingEnd="10dp"/>
            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:enabled="false"
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/hintColor"
                    android:gravity="start|center_vertical"
                    android:id="@+id/et_gas_ref"
                    android:background="@drawable/edit_text_bg"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_35sdp"
                    android:layout_marginTop="@dimen/dp5"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:maxLength="11"
                    android:digits="0123456789"
                    android:inputType="number"
                    android:imeOptions="actionNext"
                    android:paddingStart="@dimen/dp10"
                    android:paddingEnd="@dimen/dp10"/>
            </FrameLayout>
            <TextView
                android:textSize="@dimen/sp20"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/btn_update"
                android:background="@drawable/login_button_bk"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_35sdp"
                android:layout_marginTop="@dimen/_50sdp"
                android:text="@string/button_update"
                android:layout_below="@+id/ll_spinner"
                android:fontFamily="@font/jameel_noori_nastaleeq"
                android:layout_marginStart="@dimen/dp20"
                android:layout_marginEnd="@dimen/dp20"/>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
