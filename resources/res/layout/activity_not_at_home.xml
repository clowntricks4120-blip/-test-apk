<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/colorBGGREY"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/line"
        android:layout_alignParentTop="true"/>
    <TextView
        android:textSize="@dimen/heading_text_size"
        android:textColor="@android:color/white"
        android:gravity="center_horizontal"
        android:id="@+id/tv_header"
        android:background="@color/colorSmallHeading"
        android:padding="@dimen/header_padding"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sync Complete Data/ Verify Data"
        android:layout_below="@+id/line"/>
    <TextView
        android:textSize="@dimen/heading_text_size"
        android:textColor="@android:color/white"
        android:gravity="center_horizontal"
        android:id="@+id/tv_heading_enum_list"
        android:background="@color/colorSmallHeading"
        android:padding="@dimen/header_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enumerators List \10(Not At Home Surveys)"
        android:layout_below="@+id/tv_header"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ddddd"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:layout_above="@+id/btn_return"
        android:layout_below="@+id/tv_heading_enum_list"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"/>
    <Button
        android:textSize="@dimen/textview_text_size"
        android:textColor="@android:color/white"
        android:id="@+id/btn_return"
        android:background="@color/colorButtonBlue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:layout_marginTop="@dimen/fields_margin"
        android:text="Return"
        android:layout_alignParentBottom="true"
        android:textAlignment="center"/>
</RelativeLayout>
