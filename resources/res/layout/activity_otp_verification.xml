<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#f1f5f9"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="32dp"
        android:paddingBottom="48dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#ffffff"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="36dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageButton
                        android:id="@+id/btnBack"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@android:drawable/ic_menu_revert"
                        android:layout_centerVertical="true"
                        android:contentDescription="Go Back"
                        android:layout_alignParentStart="true"
                        app:tint="#1e293b"/>
                    <LinearLayout
                        android:background="#e0e7ff"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@android:drawable/ic_lock_lock"
                            app:tint="#1a56db"/>
                        <TextView
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#1a56db"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2FA GOVERNMENT SECURE GATEWAY"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>
                </RelativeLayout>
                <TextView
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#0f172a"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Identity Verification"/>
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#475569"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="شناختی تصدیق و سیکیورٹی کوڈ"/>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    app:cardBackgroundColor="#f8fafc"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="22dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:id="@+id/ivChannelIcon"
                                android:background="#eff6ff"
                                android:padding="12dp"
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:src="@android:drawable/ic_dialog_email"
                                app:tint="#1a56db"/>
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="16dp">
                                <TextView
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:textColor="#0f172a"
                                    android:id="@+id/tvChannelTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Official Verification Channel"/>
                                <TextView
                                    android:textSize="14sp"
                                    android:textColor="#64748b"
                                    android:id="@+id/tvTargetIdentifier"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="User ID: 1410203560725"/>
                            </LinearLayout>
                        </LinearLayout>
                        <View
                            android:background="#e2e8f0"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="14dp"/>
                        <TextView
                            android:textSize="15sp"
                            android:textColor="#334155"
                            android:id="@+id/tvChannelSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Enter the 6-digit authentication PIN sent to your registered address.\10موصول شدہ 6 ہندسوں کا سیکیورٹی کوڈ درج کریں۔"
                            android:lineSpacingExtra="3dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="36dp">
                    <EditText
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#0f172a"
                        android:gravity="center"
                        android:id="@+id/otp1"
                        android:background="@drawable/bg_otp_box"
                        android:layout_width="65dp"
                        android:layout_height="75dp"
                        android:layout_margin="6dp"
                        android:maxLength="1"
                        android:inputType="number"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"/>
                    <EditText
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#0f172a"
                        android:gravity="center"
                        android:id="@+id/otp2"
                        android:background="@drawable/bg_otp_box"
                        android:layout_width="65dp"
                        android:layout_height="75dp"
                        android:layout_margin="6dp"
                        android:maxLength="1"
                        android:inputType="number"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"/>
                    <EditText
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#0f172a"
                        android:gravity="center"
                        android:id="@+id/otp3"
                        android:background="@drawable/bg_otp_box"
                        android:layout_width="65dp"
                        android:layout_height="75dp"
                        android:layout_margin="6dp"
                        android:maxLength="1"
                        android:inputType="number"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"/>
                    <EditText
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#0f172a"
                        android:gravity="center"
                        android:id="@+id/otp4"
                        android:background="@drawable/bg_otp_box"
                        android:layout_width="65dp"
                        android:layout_height="75dp"
                        android:layout_margin="6dp"
                        android:maxLength="1"
                        android:inputType="number"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"/>
                    <EditText
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#0f172a"
                        android:gravity="center"
                        android:id="@+id/otp5"
                        android:background="@drawable/bg_otp_box"
                        android:layout_width="65dp"
                        android:layout_height="75dp"
                        android:layout_margin="6dp"
                        android:maxLength="1"
                        android:inputType="number"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"/>
                    <EditText
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#0f172a"
                        android:gravity="center"
                        android:id="@+id/otp6"
                        android:background="@drawable/bg_otp_box"
                        android:layout_width="65dp"
                        android:layout_height="75dp"
                        android:layout_margin="6dp"
                        android:maxLength="1"
                        android:inputType="number"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="#64748b"
                        android:id="@+id/tvTimerPrefix"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resend code in "/>
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#0f172a"
                        android:id="@+id/tvTimerCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:60"/>
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1a56db"
                        android:id="@+id/btnResend"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resend OTP  •  دوبارہ بھیجیں"/>
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatButton
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:id="@+id/btnVerify"
                    android:background="@drawable/bg_primary_button"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="34dp"
                    android:text="VERIFY &amp; PROCEED  •  تصدیق کریں"/>
                <ProgressBar
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/pbLoading"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#94a3b8"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="36dp"
                    android:text="Official Government Encrypted Session • Protected by Two-Factor Authentication"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
