<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#f4f6f9"
    android:padding="40dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp">
            <TextView
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#1c1c1e"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SIM Confirmation"/>
        </LinearLayout>
        <EditText
            android:textSize="28sp"
            android:gravity="center"
            android:id="@+id/et_cnic"
            android:background="@drawable/bg_input_field"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginBottom="20dp"
            android:hint="Enter CNIC (13 digits)"
            android:maxLength="15"
            android:inputType="number"/>
        <Button
            android:enabled="false"
            android:textSize="20sp"
            android:textStyle="bold"
            android:id="@+id/btn_verify_cnic"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginBottom="20dp"
            android:text="VERIFY CNIC"
            android:textAllCaps="true"
            android:backgroundTint="#9e9e9e"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/checkCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">
            <ImageView
                android:id="@+id/checkCountImg"
                android:background="@drawable/fab_new_survey_drawable_circle"
                android:padding="10dp"
                android:clickable="true"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/plus"/>
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#1c1c1e"
                android:id="@+id/checkCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Check Count"/>
        </LinearLayout>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress_loading"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/layout_phone_section"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="28sp"
                android:textColor="#333333"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Select Operator"/>
            <Spinner
                android:id="@+id/sp_operator"
                android:background="@drawable/bg_spinner_field"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginBottom="24dp"
                android:spinnerMode="dropdown"/>
            <ivas.gov.bisp.enumeration.utils.NoPasteEditText
                android:textSize="28sp"
                android:id="@+id/et_phone"
                android:background="@drawable/bg_input_field"
                android:padding="16dp"
                android:longClickable="false"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginBottom="16dp"
                android:hint="Enter Phone Number"
                android:cursorVisible="true"
                android:maxLength="12"
                android:digits="0123456789"
                android:inputType="phone"
                android:textIsSelectable="false"
                android:contextClickable="false"
                android:importantForAutofill="no"/>
            <ivas.gov.bisp.enumeration.utils.NoPasteEditText
                android:textSize="28sp"
                android:id="@+id/et_confirm_phone"
                android:background="@drawable/bg_input_field"
                android:padding="16dp"
                android:longClickable="false"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginBottom="30dp"
                android:hint="Confirm Phone Number"
                android:cursorVisible="true"
                android:maxLength="12"
                android:digits="0123456789"
                android:inputType="phone"
                android:textIsSelectable="false"
                android:contextClickable="false"
                android:importantForAutofill="no"/>
            <Button
                android:enabled="false"
                android:textSize="20sp"
                android:textStyle="bold"
                android:id="@+id/btn_submit"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:text="SUBMIT"
                android:textAllCaps="true"
                android:elevation="4dp"
                android:backgroundTint="#9e9e9e"/>
        </LinearLayout>
        <TextView
            android:id="@+id/application_version_textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_20sdp"
            android:layout_marginRight="@dimen/_20sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            android:text=""
            android:layout_toLeftOf="@+id/fab_sync"
            android:layout_alignParentBottom="true"
            android:layout_toStartOf="@+id/fab_sync"/>
    </LinearLayout>
</ScrollView>
