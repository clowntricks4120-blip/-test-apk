<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/btn_save">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/line"/>
        <TextView
            android:textSize="@dimen/heading_text_size"
            android:textColor="@android:color/white"
            android:gravity="center_horizontal"
            android:background="@color/colorButtonBlue"
            android:padding="@dimen/header_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:text="@string/heading_agriculture"/>
        <TextView
            android:textSize="@dimen/heading_text_size"
            android:gravity="right"
            android:id="@+id/tv_time_remaining"
            android:padding="@dimen/header_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Time Remaining : 0"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:padding="5dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <Spinner
                            android:id="@+id/sp_agri_type"
                            android:background="@drawable/spinner_bg"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/ll_other_land"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp">
                            <EditText
                                android:textSize="@dimen/textview_text_size"
                                android:id="@+id/tv_owner_name"
                                android:background="@drawable/edit_text_bg"
                                android:padding="5dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="5dp"
                                android:hint="@string/owner_name"
                                android:maxLines="1"
                                android:digits=" qwertzuiopasdfghjklyxcvbnmQWERTYUIOPASDFGHJKLZXCVBNM"
                                android:inputType="textPersonName"
                                android:imeOptions="actionNext"
                                android:fontFamily="@font/jameel_noori_nastaleeq"/>
                            <EditText
                                android:textSize="@dimen/textview_text_size"
                                android:id="@+id/tv_owner_mobile"
                                android:background="@drawable/edit_text_bg"
                                android:padding="5dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="5dp"
                                android:hint="@string/mobile_number"
                                android:maxLines="1"
                                android:maxLength="@integer/phone_number_length"
                                android:digits="0123456789"
                                android:inputType="numberDecimal"
                                android:imeOptions="actionNext"
                                android:fontFamily="@font/jameel_noori_nastaleeq"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/ll_land_detail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp">
                            <TextView
                                android:textSize="@dimen/textview_text_size"
                                android:gravity="center"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginBottom="5dp"
                                android:text="@string/land_detail"
                                android:fontFamily="@font/jameel_noori_nastaleeq"/>
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">
                                <Spinner
                                    android:id="@+id/sp_unit"
                                    android:background="@drawable/spinner_bg"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginRight="2dp"
                                    android:layout_weight="0.6"/>
                                <EditText
                                    android:textSize="@dimen/textview_text_size"
                                    android:id="@+id/et_number"
                                    android:background="@drawable/et_bg"
                                    android:padding="5dp"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginLeft="2dp"
                                    android:hint="@string/quantity"
                                    android:maxLength="5"
                                    android:digits="@string/digits"
                                    android:layout_weight="0.4"
                                    android:inputType="numberDecimal"
                                    android:imeOptions="actionDone"
                                    android:fontFamily="@font/jameel_noori_nastaleeq"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_weather_crop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:textSize="@dimen/textview_text_size"
                        android:gravity="center"
                        android:id="@+id/textView4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="5dp"
                        android:text="@string/weather_crop"
                        android:fontFamily="@font/jameel_noori_nastaleeq"/>
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <LinearLayout
                                android:orientation="vertical"
                                android:padding="5dp"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">
                                <LinearLayout
                                    android:gravity="center_vertical"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_marginBottom="5dp">
                                    <RadioGroup
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal"
                                        android:id="@+id/rg_rabi"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content">
                                        <RadioButton
                                            android:textSize="@dimen/textview_text_size"
                                            android:id="@+id/rb_rabi_yes"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="10dp"
                                            android:text="@string/yes"
                                            android:fontFamily="@font/jameel_noori_nastaleeq"
                                            android:buttonTint="@color/colorButtonGreen"/>
                                        <RadioButton
                                            android:textSize="@dimen/textview_text_size"
                                            android:id="@+id/rb_rabi_no"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="10dp"
                                            android:text="@string/no"
                                            android:fontFamily="@font/jameel_noori_nastaleeq"
                                            android:buttonTint="@color/colorButtonRed"/>
                                    </RadioGroup>
                                    <TextView
                                        android:textSize="@dimen/textview_text_size"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:text="@string/rabi_crop"
                                        android:fontFamily="@font/jameel_noori_nastaleeq"/>
                                </LinearLayout>
                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/rv_rabi_crop"
                                    android:visibility="gone"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="10dp"
                                    android:nestedScrollingEnabled="false"/>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="vertical"
                                android:padding="5dp"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">
                                <LinearLayout
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_marginBottom="5dp">
                                    <RadioGroup
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal"
                                        android:id="@+id/rg_khareef"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content">
                                        <RadioButton
                                            android:textSize="@dimen/textview_text_size"
                                            android:id="@+id/rb_khareef_yes"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="10dp"
                                            android:text="@string/yes"
                                            android:fontFamily="@font/jameel_noori_nastaleeq"
                                            android:buttonTint="@color/colorButtonGreen"/>
                                        <RadioButton
                                            android:textSize="@dimen/textview_text_size"
                                            android:id="@+id/rb_khareef_no"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginRight="10dp"
                                            android:text="@string/no"
                                            android:fontFamily="@font/jameel_noori_nastaleeq"
                                            android:buttonTint="@color/colorButtonRed"/>
                                    </RadioGroup>
                                    <TextView
                                        android:textSize="@dimen/textview_text_size"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:text="@string/khareef_crop"
                                        android:fontFamily="@font/jameel_noori_nastaleeq"/>
                                </LinearLayout>
                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/rv_khareef_crop"
                                    android:visibility="gone"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="10dp"
                                    android:nestedScrollingEnabled="false"/>
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cv_water_res"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp">
                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="@dimen/textview_text_size"
                                android:gravity="center"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginBottom="5dp"
                                android:text="@string/water_resource"
                                android:fontFamily="@font/jameel_noori_nastaleeq"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cv_crop_asset"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp">
                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="@dimen/textview_text_size"
                                android:gravity="center"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginBottom="5dp"
                                android:text="@string/crop_resource"
                                android:fontFamily="@font/jameel_noori_nastaleeq"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
    <Button
        android:textSize="@dimen/textview_text_size"
        android:textColor="@android:color/white"
        android:id="@+id/btn_save"
        android:background="@drawable/btn_selector_roster"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:text="@string/save"
        android:layout_alignParentBottom="true"
        android:textAlignment="center"/>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/application_version_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_10sdp"
        android:text="App Version: "
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
</RelativeLayout>
