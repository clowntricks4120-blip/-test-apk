<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">
    <LinearLayout
        android:orientation="horizontal"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/imgBike"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/motorbike"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp">
            <TextView
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#1e1e1e"
                android:id="@+id/tvBikeOwner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saleem Bajwa"/>
            <TextView
                android:textSize="26sp"
                android:textColor="#1e1e1e"
                android:id="@+id/tvBikeNic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4220*******9"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="20sp"
                    android:textColor="#1e1e1e"
                    android:id="@+id/tvBikeNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BJU-645"/>
                <View
                    android:layout_width="10dp"
                    android:layout_height="1dp"/>
                <TextView
                    android:textSize="20sp"
                    android:textColor="#0a8f3c"
                    android:id="@+id/tvBikeType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="70 CC"/>
            </LinearLayout>
            <TextView
                android:textSize="20sp"
                android:textColor="#666"
                android:id="@+id/tvProvince"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Punjab"/>
            <TextView
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALIVE"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="center"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/arrow_forward"
            android:backgroundTint="#888"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
