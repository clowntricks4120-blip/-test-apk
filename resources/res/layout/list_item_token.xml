<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="left"
        android:orientation="horizontal"
        android:paddingTop="@dimen/_10sdp"
        android:paddingBottom="@dimen/_10sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="5">
        <RelativeLayout
            android:id="@+id/name_icon_relativeLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5">
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/name_letter_list_item_textView"
                android:background="@drawable/circle_shape"
                android:paddingBottom="10dp"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:text="  "
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/_10sdp"
            android:layout_weight="3.5">
            <TextView
                android:textAppearance="?attr/textAppearanceListItem"
                android:textSize="@dimen/_12sdp"
                android:gravity="left"
                android:id="@+id/beneficiary_name_list_item_textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textAppearance="?attr/textAppearanceListItem"
                android:textSize="@dimen/_8sdp"
                android:textColor="@color/textColor"
                android:gravity="left"
                android:id="@+id/beneficiary_cnic_list_item_textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:background="#508733"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</LinearLayout>
