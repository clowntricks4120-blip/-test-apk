<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    app:cardBackgroundColor="@color/cropCVBg">
    <LinearLayout
        android:orientation="vertical"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <CheckBox
            android:textSize="@dimen/subheading_text_size"
            android:gravity="end|center_vertical"
            android:id="@+id/cb_selected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="textEnd"
            android:buttonTint="@color/colorButtonGreen"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_land_detail"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_weight="1">
            <Spinner
                android:id="@+id/sp_unit"
                android:background="@drawable/spinner_bg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginRight="2dp"
                android:layout_weight="0.6"/>
            <EditText
                android:textSize="@dimen/subheading_text_size"
                android:id="@+id/et_number"
                android:background="@drawable/et_bg"
                android:padding="5dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="2dp"
                android:hint="@string/quantity"
                android:maxLength="5"
                android:digits="0123456789"
                android:layout_weight="0.4"
                android:inputType="numberDecimal"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
