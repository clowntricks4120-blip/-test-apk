<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/heading_text_size"
        android:textColor="@android:color/white"
        android:gravity="center_horizontal"
        android:background="@color/orangeColor"
        android:padding="@dimen/header_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/heading_bisp_surveyed"/>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingTop="@dimen/activity_vertical_margin"
            android:paddingRight="@dimen/activity_horizontal_margin"
            android:paddingBottom="@dimen/fields_padding"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/textview_text_size"
                android:textColor="@color/black"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/select_option"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:weightSum="1">
                <RadioGroup
                    android:orientation="horizontal"
                    android:id="@+id/rg_options"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layoutDirection="ltr">
                    <RadioButton
                        android:textSize="@dimen/enumerator_row_size"
                        android:id="@+id/rb_op_left_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:text="@string/option_left_right"
                        android:buttonTint="@color/colorButtonGreen"/>
                    <RadioButton
                        android:textSize="@dimen/enumerator_row_size"
                        android:id="@+id/rb_nearest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:text="@string/option_nearest"
                        android:buttonTint="@color/colorButtonBlue"/>
                    <RadioButton
                        android:textSize="@dimen/enumerator_row_size"
                        android:id="@+id/rb_none"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:text="@string/option_none"
                        android:buttonTint="@color/colorButtonRed"/>
                </RadioGroup>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_question1"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="@dimen/textview_text_size"
                    android:textColor="@color/black"
                    android:id="@+id/tv_q1"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/left"/>
                <TextView
                    android:textSize="@dimen/textview_text_size"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sp_question_4"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:weightSum="1">
                    <RadioGroup
                        android:orientation="vertical"
                        android:id="@+id/rg_question1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layoutDirection="rtl">
                        <RadioButton
                            android:textSize="@dimen/textview_text_size"
                            android:id="@+id/rb_q4_op1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:text="@string/answer1_question4"
                            android:buttonTint="@color/colorButtonGreen"/>
                        <RadioButton
                            android:textSize="@dimen/textview_text_size"
                            android:id="@+id/rb_q4_op2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:text="@string/answer2_question4"
                            android:buttonTint="@color/colorButtonGreen"/>
                        <RadioButton
                            android:textSize="@dimen/textview_text_size"
                            android:id="@+id/rb_q4_op3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:text="@string/answer3_question4"
                            android:buttonTint="@color/colorButtonGreen"/>
                        <RadioButton
                            android:textSize="@dimen/textview_text_size"
                            android:id="@+id/rb_q4_op4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:text="@string/answer4_question4"
                            android:buttonTint="@color/colorButtonGreen"/>
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_question2"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="@dimen/textview_text_size"
                    android:textColor="@color/black"
                    android:id="@+id/tv_q2"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/right"/>
                <TextView
                    android:textSize="@dimen/textview_text_size"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sp_question_4"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:weightSum="1">
                    <RadioGroup
                        android:orientation="vertical"
                        android:id="@+id/rg2_question1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layoutDirection="rtl">
                        <RadioButton
                            android:textSize="@dimen/textview_text_size"
                            android:id="@+id/rb2_q4_op1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:text="@string/answer1_question4"
                            android:buttonTint="@color/colorButtonGreen"/>
                        <RadioButton
                            android:textSize="@dimen/textview_text_size"
                            android:id="@+id/rb2_q4_op2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:text="@string/answer2_question4"
                            android:buttonTint="@color/colorButtonGreen"/>
                        <RadioButton
                            android:textSize="@dimen/textview_text_size"
                            android:id="@+id/rb2_q4_op3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:text="@string/answer3_question4"
                            android:buttonTint="@color/colorButtonGreen"/>
                        <RadioButton
                            android:textSize="@dimen/textview_text_size"
                            android:id="@+id/rb2_q4_op4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:text="@string/answer4_question4"
                            android:buttonTint="@color/colorButtonGreen"/>
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
