<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:textColor="@android:color/white"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/ll_grid_item"
    android:background="@drawable/rounded_border_layout"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="@dimen/grid_image_size"
        android:layout_height="@dimen/grid_image_size"
        android:src="@drawable/grid_not_home"/>
    <TextView
        android:textAppearance="@style/Base.TextAppearance.AppCompat.Medium"
        android:gravity="center"
        android:id="@+id/tv_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="View Submission/Validate Submission"
        android:maxLines="2"
        android:minLines="2"/>
</LinearLayout>
