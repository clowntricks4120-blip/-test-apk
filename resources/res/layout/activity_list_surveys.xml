<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/line"
        android:layout_alignParentTop="true"/>
    <TextView
        android:textSize="24sp"
        android:textColor="@android:color/white"
        android:gravity="center_horizontal"
        android:id="@+id/tv_heading"
        android:background="@color/colorSmallHeading"
        android:padding="@dimen/header_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enumerator Sample Surveys Data"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/tv_heading">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_verify"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <TextView
                android:textAppearance="@style/Base.TextAppearance.AppCompat.Large"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"
                android:padding="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Verify Surveys"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_survey_verification"
                android:visibility="gone"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="24sp"
                android:gravity="center"
                android:id="@+id/tv_no_survey_verification"
                android:padding="@dimen/header_padding"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="10dp"
                android:text="No survey(s) to validate"/>
        </LinearLayout>
        <View
            android:background="@color/black"
            android:layout_width="match_parent"
            android:layout_height="2dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_list_cnic"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <TextView
                android:textAppearance="@style/Base.TextAppearance.AppCompat.Large"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"
                android:padding="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Verify CNICs"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_survey_cnic"
                android:visibility="gone"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="24sp"
                android:gravity="center"
                android:id="@+id/tv_no_survey_cnic"
                android:padding="@dimen/header_padding"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="10dp"
                android:text="No survey(s) to validate"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
