                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp"
                            android:hint="@string/head_household"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:maxLength="30"
                            android:digits=" qwertzuiopasdfghjklyxcvbnmQWERTYUIOPASDFGHJKLZXCVBNM"
                            android:inputType="textPersonName"
                            android:imeOptions="actionNext"/>
                        <EditText
                            android:textSize="@dimen/textview_text_size"
                            android:id="@+id/address_of_house_nearest"
                            android:background="@drawable/edit_text_bg"
                            android:nextFocusDown="@+id/mobile_number_nearest"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp"
                            android:hint="@string/house_address"
                            android:maxLines="1"
                            android:digits="@string/digits_address"
                            android:inputType="textPostalAddress"
                            android:imeOptions="actionNext"/>
                        <EditText
                            android:textSize="@dimen/textview_text_size"
                            android:id="@+id/mobile_number_nearest"
                            android:background="@drawable/edit_text_bg"
                            android:nextFocusDown="@+id/mobile_number_repeat_nearest"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp"
                            android:hint="@string/mobile_number"
                            android:maxLines="1"
                            android:maxLength="@integer/phone_number_length"
                            android:digits="0123456789"
                            android:inputType="numberPassword"
                            android:imeOptions="actionNext"/>
                        <EditText
                            android:textSize="@dimen/textview_text_size"
                            android:id="@+id/mobile_number_repeat_nearest"
                            android:background="@drawable/edit_text_bg"
                            android:nextFocusDown="@+id/alternative_contact_nearest"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp"
                            android:hint="@string/mobile_number_repeat"
                            android:maxLines="1"
                            android:maxLength="@integer/phone_number_length"
                            android:digits="0123456789"
                            android:inputType="numberPassword"
                            android:imeOptions="actionDone"/>
                        <EditText
                            android:textSize="@dimen/textview_text_size"
                            android:id="@+id/alternative_contact_nearest"
                            android:background="@drawable/edit_text_bg"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp"
                            android:hint="@string/alternative_contact"
                            android:maxLines="1"
                            android:maxLength="@integer/phone_number_length"
                            android:digits="0123456789"
                            android:inputType="numberDecimal"
                            android:imeOptions="actionDone"/>
                        <EditText
                            android:textSize="@dimen/textview_text_size"
                            android:id="@+id/reason_nearest"
                            android:background="@drawable/edit_text_bg"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp"
                            android:hint="@string/reason"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:maxLength="300"
                            android:digits="@string/digits"
                            android:inputType="textPersonName"
                            android:imeOptions="actionNext"/>
                        <Button
                            android:gravity="center"
                            android:id="@+id/btn_take_pic_nearest"
                            android:background="@drawable/btn_selector_household"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="5dp"
                            android:text="@string/household_pic"
                            android:drawableLeft="@android:drawable/ic_menu_camera"
                            android:drawablePadding="10dp"
                            android:drawableStart="@android:drawable/ic_menu_camera"
                            style="@style/buttonStyle"/>
                        <ImageView
                            android:id="@+id/imgbtn_household_nearest"
                            android:visibility="gone"
                            android:layout_width="@dimen/image_dimension"
                            android:layout_height="@dimen/image_dimension"
                            android:scaleType="fitCenter"
                            android:adjustViewBounds="true"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
