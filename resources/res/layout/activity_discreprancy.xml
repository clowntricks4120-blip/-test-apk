<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/backgroundColor"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_actionbar"
        android:background="@color/colorButtonBlue"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_30sdp">
        <TextView
            android:textSize="@dimen/_10sdp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Discreprancy"
            android:layout_centerInParent="true"
            android:textAllCaps="true"/>
    </RelativeLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/_5sdp"
        android:layout_above="@+id/btn_submit"
        android:layout_below="@+id/rl_actionbar">
        <LinearLayout
            android:orientation="vertical"
            android:padding="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/ll_cnic"
                android:background="@drawable/rounded_border_layout"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Update CNIC"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp20"
                    android:layout_centerInParent="true">
                    <TextView
                        android:textSize="@dimen/sp20"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp20"
                        android:text="@string/login"
                        android:layout_marginStart="@dimen/dp10"
                        android:layout_marginEnd="@dimen/dp10"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp15">
                            <TextView
                                android:textSize="@dimen/sp14"
                                android:textColor="@color/black"
                                android:gravity="start"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/cnic_no"
                                android:layout_weight="1"
                                android:textAllCaps="true"/>
                            <TextView
                                android:textSize="@dimen/sp14"
                                android:textColor="@color/black"
                                android:gravity="start"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/cnic_no_urdu"
                                android:layout_weight="1"/>
                        </LinearLayout>
                        <EditText
                            android:textSize="@dimen/_12sdp"
                            android:textColor="@color/black"
                            android:textColorHint="@color/hintColor"
                            android:gravity="start|center_vertical"
                            android:id="@+id/et_cnic"
                            android:background="@drawable/edit_text_bg"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_35sdp"
                            android:layout_marginTop="@dimen/dp5"
                            android:hint="_____-_______-_"
                            android:maxLines="1"
                            android:maxLength="13"
                            android:digits="0123456789"
                            android:inputType="number"
                            android:paddingStart="@dimen/dp10"
                            android:paddingEnd="@dimen/dp10"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/ll_dob"
                android:background="@drawable/rounded_border_layout"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Update Date of birth"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp20">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp15">
                        <TextView
                            android:textSize="@dimen/sp14"
                            android:textColor="@color/black"
                            android:gravity="start"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/enter_dob"
                            android:layout_weight="1"
                            android:textAllCaps="true"/>
                        <TextView
                            android:textSize="@dimen/sp14"
                            android:textColor="@color/black"
                            android:gravity="start"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/enter_dob_urdu"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <EditText
                        android:textSize="@dimen/_12sdp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/hintColor"
                        android:gravity="start|center_vertical"
                        android:id="@+id/et_dob"
                        android:background="@drawable/edit_text_bg"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_35sdp"
                        android:layout_marginTop="@dimen/dp5"
                        android:hint="__/__/____"
                        android:maxLines="1"
                        android:maxLength="10"
                        android:digits="0123456789"
                        android:editable="false"
                        android:inputType="none"
                        android:paddingStart="@dimen/dp10"
                        android:paddingEnd="@dimen/dp10"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/ll_address"
                android:background="@drawable/rounded_border_layout"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Change address"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp20">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp15">
                        <TextView
                            android:textSize="@dimen/sp14"
                            android:textColor="@color/black"
                            android:gravity="start"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/house_address_eng"
                            android:layout_weight="1"
                            android:textAllCaps="true"/>
                        <TextView
                            android:textSize="@dimen/sp14"
                            android:textColor="@color/black"
                            android:gravity="start"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/house_address"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/dp10"
                            android:layout_marginEnd="@dimen/dp10"/>
                    </LinearLayout>
                    <EditText
                        android:textSize="@dimen/_12sdp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/hintColor"
                        android:gravity="start|center_vertical"
                        android:background="@drawable/edit_text_bg"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_35sdp"
                        android:layout_marginTop="@dimen/dp5"
                        android:hint="@string/house_address"
                        android:maxLines="1"
                        android:digits="@string/digits_address"
                        android:inputType="text"
                        android:paddingStart="@dimen/dp10"
                        android:paddingEnd="@dimen/dp10"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/ll_phone"
                android:background="@drawable/rounded_border_layout"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Update phone number"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp20">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp15">
                        <TextView
                            android:textSize="@dimen/sp14"
                            android:textColor="@color/black"
                            android:gravity="start"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/phone_number"
                            android:layout_weight="1"
                            android:textAllCaps="true"/>
                        <TextView
                            android:textSize="@dimen/sp14"
                            android:textColor="@color/black"
                            android:gravity="start"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/phone_number_urdu"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/dp10"
                            android:layout_marginEnd="@dimen/dp10"/>
                    </LinearLayout>
                    <EditText
                        android:textSize="@dimen/_12sdp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/hintColor"
                        android:gravity="start|center_vertical"
                        android:id="@+id/et_phone"
                        android:background="@color/colorButtonBlue"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_35sdp"
                        android:layout_marginTop="@dimen/dp5"
                        android:hint="03*****"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:maxLength="13"
                        android:digits="0123456789"
                        android:inputType="phone"
                        android:paddingStart="@dimen/dp10"
                        android:paddingEnd="@dimen/dp10"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/ll_marital"
                android:background="@drawable/rounded_border_layout"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Update marital status"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp20">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp15">
                        <TextView
                            android:textSize="@dimen/sp14"
                            android:textColor="@color/black"
                            android:gravity="start"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/marital_status_eng"
                            android:layout_weight="1"
                            android:textAllCaps="true"/>
                        <TextView
                            android:textSize="@dimen/sp14"
                            android:textColor="@color/black"
                            android:gravity="start"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/marital_status"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <Spinner
                        android:id="@+id/sp_merital_status"
                        android:background="@drawable/spinner_bg"
                        android:padding="@dimen/_10sdp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:paddingStart="@dimen/_20sdp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/ll_disability"
                android:background="@drawable/rounded_border_layout"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Disability"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp15">
                    <TextView
                        android:textSize="@dimen/sp14"
                        android:textColor="@color/black"
                        android:gravity="start"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/disablity_status_eng"
                        android:layout_weight="1"
                        android:textAllCaps="true"/>
                    <TextView
                        android:textSize="@dimen/sp14"
                        android:textColor="@color/black"
                        android:gravity="start"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/disablity_status"
                        android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <Spinner
                        android:id="@+id/sp_disability_status"
                        android:background="@drawable/spinner_bg"
                        android:padding="@dimen/_10sdp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:paddingStart="@dimen/_20sdp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/ll_death_cert"
                android:background="@drawable/rounded_border_layout"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Death Certificate"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp20">
                    <EditText
                        android:textSize="@dimen/_12sdp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/hintColor"
                        android:gravity="start|center_vertical"
                        android:id="@+id/et_certificate_no"
                        android:background="@drawable/edit_text_bg"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_35sdp"
                        android:layout_marginTop="@dimen/dp15"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:maxLength="13"
                        android:digits="@string/digits_str_num"
                        android:inputType="phone"
                        android:paddingStart="@dimen/dp10"
                        android:paddingEnd="@dimen/dp10"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <TextView
        android:textSize="@dimen/_18sdp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/btn_submit"
        android:background="@color/colorButtonBlue"
        android:layout_width="@dimen/_230sdp"
        android:layout_height="@dimen/_40sdp"
        android:text="@string/submit"
        android:layout_alignParentBottom="true"
        android:layout_centerInParent="true"/>
</RelativeLayout>
