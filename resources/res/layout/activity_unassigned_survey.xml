<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:textColor="@android:color/white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/rounded_border_layout"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.4">
                <TextView
                    android:textSize="@dimen/survey_count"
                    android:textStyle="bold"
                    android:textColor="@color/red_cluster"
                    android:gravity="center"
                    android:id="@+id/tv_total"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <ProgressBar
                    android:id="@+id/pv_total"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:indeterminateTintMode="src_atop"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/survey_count_label"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Total Unassigned Surveys"
                android:maxLines="2"
                android:minLines="2"
                android:layout_weight="0.6"/>
        </LinearLayout>
        <Button
            android:textSize="@dimen/textview_text_size"
            android:textColor="@android:color/white"
            android:id="@+id/btn_recover"
            android:background="@color/colorButtonRed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Recover Surveys"
            android:textAlignment="center"/>
    </LinearLayout>
</RelativeLayout>
