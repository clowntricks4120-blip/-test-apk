<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cv"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp">
    <RelativeLayout
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/textview_text_size"
            android:id="@+id/enum_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="2dp"
            android:layout_toLeftOf="@+id/enum_cnic"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_toStartOf="@+id/enum_cnic"/>
        <TextView
            android:textSize="@dimen/textview_text_size"
            android:id="@+id/enum_cnic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"/>
        <TextView
            android:textSize="@dimen/enumerator_row_size"
            android:id="@+id/enum_survey_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:layout_below="@+id/enum_cnic"
            android:layout_alignParentRight="true"/>
        <TextView
            android:textSize="@dimen/enumerator_row_size"
            android:id="@+id/enum_item_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:layout_below="@+id/enum_survey_count"
            android:layout_alignParentRight="true"/>
        <TextView
            android:textSize="@dimen/enumerator_row_size"
            android:id="@+id/enum_auto_item_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:layout_below="@+id/enum_item_count"
            android:layout_alignParentRight="true"/>
        <TextView
            android:textSize="@dimen/enumerator_row_size"
            android:id="@+id/enum_verify_survey_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:layout_toLeftOf="@+id/enum_survey_count"
            android:layout_below="@+id/enum_name"
            android:layout_alignParentLeft="true"
            android:layout_toStartOf="@+id/enum_survey_count"/>
        <TextView
            android:textSize="@dimen/enumerator_row_size"
            android:id="@+id/enum_done_verify_survey_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:layout_toLeftOf="@+id/enum_item_count"
            android:layout_below="@+id/enum_verify_survey_count"
            android:layout_alignParentLeft="true"
            android:layout_toStartOf="@+id/enum_item_count"/>
        <TextView
            android:textSize="@dimen/enumerator_row_size"
            android:id="@+id/ea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:layout_toLeftOf="@+id/enum_item_count"
            android:layout_below="@+id/enum_done_verify_survey_count"
            android:layout_alignParentLeft="true"
            android:layout_toStartOf="@+id/enum_item_count"/>
        <TextView
            android:textSize="@dimen/enumerator_row_size"
            android:id="@+id/tvVisit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:layout_below="@+id/ea"
            android:layout_alignParentLeft="true"/>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
