<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#ffffff"
        app:cardCornerRadius="28dp"
        app:cardElevation="16dp">
        <LinearLayout
            android:orientation="vertical"
            android:padding="36dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_security_badge"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:backgroundTint="#ecfdf5">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/ivDialogTopIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/stat_sys_phone_call"
                    app:tint="#0f392b"/>
            </FrameLayout>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#475569"
                android:layout_gravity="center_horizontal"
                android:background="#f1f5f9"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="GOVERNMENT 2FA GATEWAY NOTIFICATION"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"/>
            <TextView
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#0f172a"
                android:gravity="center"
                android:id="@+id/tvDialogTitleEn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Mobile SIM Verification (SMS)"/>
            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#0f392b"
                android:gravity="center"
                android:id="@+id/tvDialogTitleUr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="رجسٹرڈ موبائل سم (ایس ایم ایس) کے ذریعے تصدیق"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#f8fafc"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="22dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="#334155"
                        android:id="@+id/tvDialogMessageEn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="A 6-digit OTP verification code will be dispatched via SMS to your registered SIM. Please make sure your mobile SIM signals are active."
                        android:lineSpacingExtra="3dp"/>
                    <View
                        android:background="#e2e8f0"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"/>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="#1e293b"
                        android:id="@+id/tvDialogMessageUr"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="آپ کے رجسٹرڈ سم کارڈ پر 6 ہندسوں کا او ٹی پی بھیجا جائے گا۔ براہ کرم اپنے موبائل پر سگنلز کی موجودگی یقینی بنائیں۔"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:id="@+id/btnDialogSendOtp"
                android:background="@drawable/bg_primary_button"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="28dp"
                android:text="SEND OTP  •  او ٹی پی کوڈ بھیجیں"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#64748b"
                android:layout_gravity="center_horizontal"
                android:id="@+id/btnDialogCancel"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Cancel  •  منسوخ کریں"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
