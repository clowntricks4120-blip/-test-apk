<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rootLayout"
    android:background="@color/cropCVBg"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_actionbar"
        android:background="@color/colorPrimary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_35sdp">
        <ImageView
            android:id="@+id/iv_icon"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_marginLeft="@dimen/dp10"
            android:layout_marginRight="@dimen/_10sdp"
            android:src="@drawable/bisplogo"
            android:layout_alignParentLeft="true"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/dp10"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/_11sdp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/tv_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_centerInParent="true"
            android:layout_toStartOf="@+id/ll_option"
            android:layout_toEndOf="@+id/iv_icon"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_option"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/_5sdp"
            android:layout_alignParentEnd="true">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_dowwnload"
                android:visibility="gone"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginLeft="@dimen/dp10"
                android:src="@drawable/download"
                android:layout_marginStart="@dimen/dp10"
                app:tint="@android:color/white"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_refresh"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginLeft="@dimen/dp10"
                android:src="@drawable/sync"
                android:layout_marginStart="@dimen/dp10"
                app:tint="@android:color/white"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_info"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginLeft="@dimen/dp10"
                android:src="@drawable/ic_info"
                android:layout_marginStart="@dimen/dp10"
                app:tint="@android:color/white"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_logout"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginLeft="@dimen/dp10"
                android:src="@drawable/logout_svgrepo_com"
                android:layout_marginStart="@dimen/dp10"
                app:tint="@android:color/white"/>
        </LinearLayout>
    </RelativeLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/rl_actionbar">
        <LinearLayout
            android:orientation="vertical"
            android:padding="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/rounded_border_layout"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="10dp">
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_sync_caption"
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="Last Sync"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorButtonBlueDark"
                    android:gravity="right"
                    android:id="@+id/tv_sync_time"
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:text=""
                    android:layout_weight="2"/>
            </LinearLayout>
            <LinearLayout
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/rounded_border_layout"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <ImageView
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/grid_add_locality"/>
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="Forms completed"
                    android:layout_weight="0.6"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.3">
                    <TextView
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorButtonBlueDark"
                        android:gravity="center"
                        android:id="@+id/tv_total"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""/>
                    <ProgressBar
                        android:id="@+id/pv_total"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        android:indeterminateTintMode="src_atop"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/rounded_border_layout"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <ImageView
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/grid_add_locality"/>
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="Offline Forms completed"
                    android:layout_weight="0.6"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.3">
                    <TextView
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorButtonBlueDark"
                        android:gravity="center"
                        android:id="@+id/tv_offline_total"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""/>
                    <ProgressBar
                        android:id="@+id/pv_offline_total"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        android:indeterminateTintMode="src_atop"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/rounded_border_layout"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <ImageView
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/grid_sent_data"/>
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="Forms sent"
                    android:layout_weight="0.6"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.3">
                    <TextView
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorButtonBlueDark"
                        android:gravity="center"
                        android:id="@+id/tv_total_sent"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""/>
                    <ProgressBar
                        android:id="@+id/pv_total_sent"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        android:indeterminateTintMode="src_atop"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/rounded_border_layout"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <ImageView
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/grid_sent_data"/>
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="Offline Forms sent"
                    android:layout_weight="0.6"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.3">
                    <TextView
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorButtonBlueDark"
                        android:gravity="center"
                        android:id="@+id/tv_offline_total_sent"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""/>
                    <ProgressBar
                        android:id="@+id/pv_offline_total_sent"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        android:indeterminateTintMode="src_atop"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/rounded_border_layout"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <ImageView
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/grid_sync_locality"/>
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="Forms to be uploaded"
                    android:layout_weight="0.6"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.3">
                    <TextView
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/count_green_new"
                        android:gravity="center"
                        android:id="@+id/tv_total_waiting"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""/>
                    <ProgressBar
                        android:id="@+id/pv_total_waiting"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        android:indeterminateTintMode="src_atop"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/rounded_border_layout"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <ImageView
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/grid_sync_locality"/>
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="Offline Forms to be uploaded"
                    android:layout_weight="0.6"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.3">
                    <TextView
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/count_green_new"
                        android:gravity="center"
                        android:id="@+id/tv_total_offline_waiting"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""/>
                    <ProgressBar
                        android:id="@+id/pv_total_offline_waiting"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        android:indeterminateTintMode="src_atop"/>
                </LinearLayout>
            </LinearLayout>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/progress_loading"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/not_at_home_btn"
                android:background="@drawable/rounded_border_layout"
                android:padding="10dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <ImageView
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/grid_not_home"/>
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="Not at Home List"
                    android:layout_weight="0.6"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.3">
                    <TextView
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/red_cluster"
                        android:gravity="center"
                        android:id="@+id/tv_total_not_at_home"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""/>
                    <ProgressBar
                        android:id="@+id/pv_total_not_at_home"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        android:indeterminateTintMode="src_atop"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/discrepancy_summary"
                android:background="@drawable/rounded_border_layout"
                android:padding="10dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <ImageView
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/ic_discrepant_form"/>
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="Discrepancy Summary"
                    android:layout_weight="0.6"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.3">
                    <TextView
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/red_cluster"
                        android:gravity="center"
                        android:id="@+id/tv_total_discrepancy_summary"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""/>
                    <ProgressBar
                        android:id="@+id/pv_total_discrepancy_summary"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        android:indeterminateTintMode="src_atop"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/discrepancies_detailed_list"
                android:background="@drawable/rounded_border_layout"
                android:padding="10dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <ImageView
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/ic_revisit_list"/>
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="Discrepancies Detailed List"
                    android:layout_weight="0.6"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.3">
                    <TextView
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/red_cluster"
                        android:gravity="center"
                        android:id="@+id/tv_total_revisit_surveys_list"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""/>
                    <ProgressBar
                        android:id="@+id/pv_total_revisit_surveys_list"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        android:indeterminateTintMode="src_atop"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/track_enumerator"
                android:background="@drawable/rounded_border_layout"
                android:padding="10dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <ImageView
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/ic_track_enumeration"/>
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="Track Enumerator Location"
                    android:layout_weight="0.6"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.3">
                    <TextView
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/red_cluster"
                        android:gravity="center"
                        android:id="@+id/tv_total_track"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""/>
                    <ProgressBar
                        android:id="@+id/pv_total_track"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        android:indeterminateTintMode="src_atop"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/open_support_app"
                android:background="@drawable/rounded_border_layout"
                android:padding="10dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <ImageView
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/ic_sa_launcher"/>
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="Open Support App"
                    android:layout_weight="0.6"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.3">
                    <TextView
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/red_cluster"
                        android:gravity="center"
                        android:id="@+id/tv_support_app"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""/>
                    <ProgressBar
                        android:id="@+id/pv_support_app"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        android:indeterminateTintMode="src_atop"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <ImageView
        android:id="@+id/fab_begin_survey"
        android:background="@drawable/fab_new_survey_drawable_circle"
        android:padding="10dp"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:src="@drawable/plus"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/fab_sync"
        android:background="@drawable/fab_sync_drawable_circle"
        android:padding="10dp"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:src="@drawable/ic_sync_to_super"
        android:layout_toLeftOf="@+id/fab_begin_survey"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="5dp"
        android:layout_toStartOf="@+id/fab_begin_survey"/>
    <TextView
        android:id="@+id/application_version_textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_20sdp"
