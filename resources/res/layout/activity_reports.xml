<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/activity_reports"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/heading_text_size"
        android:textColor="@android:color/white"
        android:gravity="center_horizontal"
        android:id="@+id/textView2"
        android:background="@color/colorSmallHeading"
        android:padding="@dimen/header_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reports"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.cardview.widget.CardView
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:id="@+id/rl_contact_detail"
                        android:background="@color/orangeColor"
                        android:padding="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <RelativeLayout
                            android:gravity="center"
                            android:id="@+id/btn_contact_detail"
                            android:padding="15dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="false"
                            android:layout_alignParentStart="false">
                            <View
                                android:background="@drawable/triangle"
                                android:visibility="invisible"
                                android:layout_width="10dp"
                                android:layout_height="10dp"/>
                        </RelativeLayout>
                        <TextView
                            android:textSize="@dimen/textview_text_size"
                            android:textColor="@color/white"
                            android:gravity="center_vertical"
                            android:id="@+id/tv_contact_detail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Skipping Enumerators"
                            android:layout_toRightOf="@+id/btn_contact_detail"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@+id/btn_contact_detail"/>
                    </RelativeLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/tv_no_contact_detail"
                            android:padding="10dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No Survey Detail"/>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_contact_detail"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:id="@+id/rl_household_detail"
                        android:background="@color/colorButtonGreen"
                        android:padding="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <RelativeLayout
                            android:gravity="center"
                            android:id="@+id/btn_household_detail"
                            android:padding="15dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="false"
                            android:layout_alignParentStart="false">
                            <View
                                android:background="@drawable/triangle"
                                android:visibility="invisible"
                                android:layout_width="10dp"
                                android:layout_height="10dp"/>
                        </RelativeLayout>
                        <TextView
                            android:textSize="@dimen/textview_text_size"
                            android:textColor="@color/white"
                            android:gravity="center_vertical"
                            android:id="@+id/tv_household_detail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Off Hours Collection"
                            android:layout_toRightOf="@+id/btn_household_detail"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@+id/btn_household_detail"/>
                    </RelativeLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/tv_no_household_detail"
                            android:padding="10dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No Survey Detail"/>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_household_detail"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:id="@+id/rl_asset_detail"
                        android:background="@color/brownColor"
                        android:padding="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <RelativeLayout
                            android:gravity="center"
                            android:id="@+id/btn_asset_detail"
                            android:padding="15dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="false"
                            android:layout_alignParentStart="false">
                            <View
                                android:background="@drawable/triangle"
                                android:visibility="invisible"
                                android:layout_width="10dp"
                                android:layout_height="10dp"/>
                        </RelativeLayout>
                        <TextView
                            android:textSize="@dimen/textview_text_size"
                            android:textColor="@color/white"
                            android:gravity="center_vertical"
                            android:id="@+id/tv_asset_detail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Questions Mismatch Frequency"
                            android:layout_toRightOf="@+id/btn_asset_detail"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@+id/btn_asset_detail"/>
                    </RelativeLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/tv_no_asset_detail"
                            android:padding="10dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No Survey Detail"/>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_asset_detail"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
