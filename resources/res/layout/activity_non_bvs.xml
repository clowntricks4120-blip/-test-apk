<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#f5f7fa"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#0f4c81"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Non-BVS Payment Module"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#555"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Assistant Director Workflow"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:elevation="6dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter CNIC"/>
                <EditText
                    android:textSize="28sp"
                    android:gravity="center"
                    android:id="@+id/et_cnic"
                    android:background="@drawable/bg_input_field"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginBottom="20dp"
                    android:hint="Enter CNIC"
                    android:maxLength="15"
                    android:inputType="number"/>
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter Document ID"/>
                <EditText
                    android:textSize="28sp"
                    android:gravity="center"
                    android:id="@+id/et_doc_id"
                    android:background="@drawable/bg_input_field"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginBottom="20dp"
                    android:hint="Enter ID"
                    android:inputType="number"/>
                <Button
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:id="@+id/btn_verify_cnic"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginBottom="20dp"
                    android:text="Check Beneficiary"
                    android:textAllCaps="true"
                    android:backgroundTint="#4caf50"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/btn_verify_pos_agent_parent"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Click to Open Biometric Window"/>
                    <Button
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:id="@+id/btn_verify_pos_agent"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:layout_marginBottom="20dp"
                        android:text="POS Agent Biometric"
                        android:textAllCaps="true"
                        android:backgroundTint="@color/red_cluster"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/cardResult"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="6dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:id="@+id/tvStatusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="16sp"
                    android:id="@+id/tvStatusMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
