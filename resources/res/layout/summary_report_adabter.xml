<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/relativeLayout1"
        android:background="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="13.2">
        <TextView
            android:textSize="20sp"
            android:ellipsize="end"
            android:id="@+id/id_txt"
            android:background="@drawable/cell_shape"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="id"
            android:singleLine="true"
            android:layout_weight="0.3"/>
        <TextView
            android:textSize="20sp"
            android:ellipsize="end"
            android:id="@+id/ea_txt"
            android:background="@drawable/cell_shape"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="Enumeration Area"
            android:singleLine="true"
            android:layout_weight="1"/>
        <TextView
            android:textSize="20sp"
            android:ellipsize="end"
            android:id="@+id/name_txt"
            android:background="@drawable/cell_shape"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="Name"
            android:singleLine="true"
            android:layout_weight="0.8"/>
        <TextView
            android:textSize="20sp"
            android:ellipsize="end"
            android:id="@+id/ec_txt"
            android:background="@drawable/cell_shape"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="Enumeration Count"
            android:singleLine="true"
            android:layout_weight="1.1"/>
        <TextView
            android:textSize="20sp"
            android:ellipsize="end"
            android:id="@+id/lc_txt"
            android:background="@drawable/cell_shape"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="Listing Count"
            android:singleLine="true"
            android:layout_weight="0.8"/>
        <TextView
            android:textSize="20sp"
            android:ellipsize="end"
            android:id="@+id/dc_txt"
            android:background="@drawable/cell_shape"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="Discrepancy Count"
            android:singleLine="true"
            android:layout_weight="1.1"/>
        <TextView
            android:textSize="20sp"
            android:ellipsize="end"
            android:id="@+id/ep_txt"
            android:background="@drawable/cell_shape"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="Enumeration Percentage"
            android:singleLine="true"
            android:layout_weight="1.5"/>
        <TextView
            android:textSize="20sp"
            android:ellipsize="end"
            android:id="@+id/lp_txt"
            android:background="@drawable/cell_shape"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="Listing Percentage"
            android:singleLine="true"
            android:layout_weight="1.2"/>
        <TextView
            android:textSize="20sp"
            android:ellipsize="end"
            android:id="@+id/dis_per_txt"
            android:background="@drawable/cell_shape"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="Discrepancy Percentage"
            android:singleLine="true"
            android:layout_weight="1.5"/>
        <TextView
            android:textSize="20sp"
            android:ellipsize="end"
            android:id="@+id/dr_txt"
            android:background="@drawable/cell_shape"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="Discrepancy Resolve"
            android:singleLine="true"
            android:layout_weight="1.4"/>
        <TextView
            android:textSize="20sp"
            android:ellipsize="end"
            android:id="@+id/drp_txt"
            android:background="@drawable/cell_shape"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="Discrepancy Resolve Percentage"
            android:singleLine="true"
            android:layout_weight="2.5"/>
    </LinearLayout>
</LinearLayout>
