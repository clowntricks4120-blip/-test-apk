<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/backgroundColor"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_actionbar"
        android:background="@color/actionbarColor"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_30sdp">
        <ImageView
            android:id="@+id/iv_back"
            android:padding="5dp"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_marginLeft="@dimen/dp10"
            android:src="@drawable/ic_back"
            android:layout_alignParentLeft="true"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/dp10"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/_10sdp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/update_address"
            android:layout_centerInParent="true"
            android:textAllCaps="true"/>
        <TextView
            android:textColor="@color/white"
            android:id="@+id/application_version_textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/_10sdp"
            android:text="App Version: "
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/rl_actionbar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp20">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp15">
                <TextView
                    android:textSize="@dimen/_11sdp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/basic_information"
                    android:layout_weight="1"
                    android:textAllCaps="false"
                    android:fontFamily="@font/jameel_noori_nastaleeq"/>
                <TextView
                    android:textSize="@dimen/_11sdp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/basic_information_urdu"
                    android:layout_weight="1"
                    android:fontFamily="@font/jameel_noori_nastaleeq"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_spinner_province"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rl_actionbar">
                <Spinner
                    android:id="@+id/sp_province"
                    android:background="@drawable/spinner_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="Province"
                    android:fontFamily="@font/jameel_noori_nastaleeq"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_spinner_district"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rl_actionbar">
                <Spinner
                    android:id="@+id/sp_district"
                    android:background="@drawable/spinner_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="District"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_spinner_tehsil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rl_actionbar">
                <Spinner
                    android:id="@+id/sp_tehsil"
                    android:background="@drawable/spinner_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="Tehsil"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_spinner_uc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rl_actionbar">
                <Spinner
                    android:id="@+id/sp_uc"
                    android:background="@drawable/spinner_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="Status of Visit"/>
                <EditText
                    android:enabled="true"
                    android:textSize="@dimen/textview_text_size"
                    android:textColor="#000000"
                    android:gravity="right"
                    android:id="@+id/et_uc"
                    android:background="@drawable/edit_text_bg"
                    android:padding="10dp"
                    android:paddingLeft="30dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="@string/union_council_name"
                    android:digits="@string/digits_address"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_spinner_village"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rl_actionbar">
                <Spinner
                    android:id="@+id/sp_village"
                    android:background="@drawable/spinner_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="Status of Visit"/>
                <EditText
                    android:enabled="true"
                    android:textSize="@dimen/textview_text_size"
                    android:textColor="#000000"
                    android:gravity="right"
                    android:id="@+id/et_village"
                    android:background="@drawable/edit_text_bg"
                    android:padding="10dp"
                    android:paddingLeft="30dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="@string/village_name"
                    android:digits="@string/digits_address"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp15">
                <TextView
                    android:textSize="@dimen/_11sdp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/village_street"
                    android:layout_weight="1"
                    android:textAllCaps="false"
                    android:fontFamily="@font/jameel_noori_nastaleeq"/>
                <TextView
                    android:textSize="@dimen/_11sdp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/village_street_urdu"
                    android:layout_weight="1"
                    android:fontFamily="@font/jameel_noori_nastaleeq"/>
            </LinearLayout>
            <EditText
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/black"
                android:textColorHint="@color/hintColor"
                android:gravity="start|center_vertical"
                android:id="@+id/et_village_st"
                android:background="@drawable/edit_text_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_35sdp"
                android:layout_marginTop="@dimen/dp5"
                android:maxLines="1"
                android:singleLine="true"
                android:maxLength="50"
                android:digits="@string/digits_address"
                android:inputType="textPersonName"
                android:paddingStart="@dimen/dp10"
                android:paddingEnd="@dimen/dp10"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp15">
                <TextView
                    android:textSize="@dimen/_11sdp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/temp_address"
                    android:layout_weight="1"
                    android:textAllCaps="false"
                    android:fontFamily="@font/jameel_noori_nastaleeq"/>
                <TextView
                    android:textSize="@dimen/_11sdp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/temp_address_urdu"
                    android:layout_weight="1"
                    android:fontFamily="@font/jameel_noori_nastaleeq"/>
            </LinearLayout>
            <EditText
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/black"
                android:textColorHint="@color/hintColor"
                android:gravity="start|center_vertical"
                android:id="@+id/et_temp_address"
                android:background="@drawable/edit_text_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_35sdp"
                android:layout_marginTop="@dimen/dp5"
                android:maxLines="1"
                android:singleLine="true"
                android:maxLength="80"
                android:digits="@string/digits_address"
                android:inputType="textPersonName"
                android:paddingStart="@dimen/dp10"
                android:paddingEnd="@dimen/dp10"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp15">
                <TextView
                    android:textSize="@dimen/_11sdp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/network_type"
                    android:layout_weight="1"
                    android:textAllCaps="false"
                    android:fontFamily="@font/jameel_noori_nastaleeq"/>
                <TextView
                    android:textSize="@dimen/_11sdp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/network_type_urdu"
                    android:layout_weight="1"
                    android:fontFamily="@font/jameel_noori_nastaleeq"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rl_actionbar">
                <Spinner
                    android:id="@+id/sp_networks"
                    android:background="@drawable/spinner_bg"
                    android:nextFocusDown="@+id/mobile_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp15">
                <TextView
                    android:textSize="@dimen/_11sdp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/contact_no"
                    android:layout_weight="1"
                    android:textAllCaps="false"
                    android:fontFamily="@font/jameel_noori_nastaleeq"/>
                <TextView
                    android:textSize="@dimen/_11sdp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/contact_no_urdu"
                    android:layout_weight="1"
                    android:fontFamily="@font/jameel_noori_nastaleeq"/>
            </LinearLayout>
            <EditText
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/black"
                android:textColorHint="@color/hintColor"
                android:gravity="start|center_vertical"
                android:id="@+id/et_phone"
                android:background="@drawable/edit_text_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_35sdp"
                android:layout_marginTop="@dimen/dp5"
                android:hint="03*********"
                android:maxLines="1"
                android:singleLine="true"
                android:maxLength="11"
                android:digits="0123456789"
                android:inputType="phone"
                android:paddingStart="@dimen/dp10"
                android:paddingEnd="@dimen/dp10"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp15">
                <TextView
                    android:textSize="@dimen/_11sdp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/contact_no_again"
                    android:layout_weight="1"
                    android:textAllCaps="false"
                    android:fontFamily="@font/jameel_noori_nastaleeq"/>
                <TextView
                    android:textSize="@dimen/_11sdp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/contact_no_again_urdu"
                    android:layout_weight="1"
                    android:fontFamily="@font/jameel_noori_nastaleeq"/>
            </LinearLayout>
            <EditText
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/black"
                android:textColorHint="@color/hintColor"
                android:gravity="start|center_vertical"
                android:id="@+id/et_conf_phone"
                android:background="@drawable/edit_text_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_35sdp"
                android:layout_marginTop="@dimen/dp5"
                android:hint="03*********"
                android:maxLines="1"
                android:singleLine="true"
                android:maxLength="11"
                android:digits="0123456789"
                android:inputType="phone"
                android:paddingStart="@dimen/dp10"
                android:paddingEnd="@dimen/dp10"/>
            <TextView
                android:textSize="@dimen/sp20"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/btn_update"
                android:background="@drawable/login_button_bk"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp60"
                android:layout_marginTop="@dimen/dp50"
                android:text="@string/button_update"
                android:layout_below="@+id/ll_spinner"
                android:fontFamily="@font/jameel_noori_nastaleeq"
                android:layout_marginStart="@dimen/dp30"
                android:layout_marginEnd="@dimen/dp30"/>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
