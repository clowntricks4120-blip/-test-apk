<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/heading_text_size"
        android:textColor="@android:color/white"
        android:gravity="center_horizontal"
        android:background="@color/orangeColor"
        android:padding="@dimen/header_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/heading_form_type"/>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingTop="@dimen/activity_vertical_margin"
            android:paddingRight="@dimen/activity_horizontal_margin"
            android:paddingBottom="@dimen/fields_padding"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/subheading_text_size"
                    android:textColor="@android:color/black"
                    android:padding="@dimen/subheading_padding"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/a_subheading_form_type"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:weightSum="1">
                    <RadioGroup
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/rg_type"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <RadioButton
                            android:enabled="true"
                            android:textSize="@dimen/enumerator_row_size"
                            android:layout_gravity="start"
                            android:id="@+id/rb_sampling"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:text="@string/sampling"
                            android:layout_weight="0.5"
                            android:buttonTint="@color/colorButtonGreen"/>
                        <RadioButton
                            android:enabled="true"
                            android:textSize="@dimen/enumerator_row_size"
                            android:layout_gravity="end"
                            android:id="@+id/rb_monitoring"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:text="@string/monitoring"
                            android:layout_weight="0.5"
                            android:buttonTint="@color/colorButtonRed"/>
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_snowball_type"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/textview_text_size"
                    android:textColor="@color/black"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="@string/snowball_type"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:weightSum="1">
                    <RadioGroup
                        android:orientation="horizontal"
                        android:id="@+id/rg_options"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layoutDirection="ltr">
                        <RadioButton
                            android:textSize="@dimen/enumerator_row_size"
                            android:id="@+id/rb_left"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:text="@string/option_left"
                            android:buttonTint="@color/colorButtonGreen"/>
                        <RadioButton
                            android:textSize="@dimen/enumerator_row_size"
                            android:id="@+id/rb_right"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:text="@string/option_right"
                            android:buttonTint="@color/colorButtonGreen"/>
                        <RadioButton
                            android:textSize="@dimen/enumerator_row_size"
                            android:id="@+id/rb_nearest"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:text="@string/option_nearest"
                            android:buttonTint="@color/colorButtonGreen"/>
                        <RadioButton
                            android:textSize="@dimen/enumerator_row_size"
                            android:id="@+id/rb_fresh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:text="@string/option_fresh"
                            android:buttonTint="@color/colorButtonGreen"/>
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
