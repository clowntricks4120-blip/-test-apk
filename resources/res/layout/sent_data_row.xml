<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/action_bar_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/fields_margin">
    <RelativeLayout
        android:id="@+id/rl_row"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/ll_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/textview_text_size"
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:id="@+id/header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:text="Enumerator Name"
                android:layout_toLeftOf="@+id/header_percentage"
                android:layout_alignParentLeft="true"
                android:layout_toStartOf="@+id/header_percentage"/>
            <TextView
                android:textSize="@dimen/textview_text_size"
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:id="@+id/header_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="97.54%"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/textview_text_size"
            android:textColor="@android:color/white"
            android:gravity="center_vertical"
            android:id="@+id/batch_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:text="2016-12-29 10:44:58"
            android:layout_below="@+id/ll_data"
            android:layout_alignParentLeft="true"/>
        <CheckBox
            android:textSize="@dimen/textview_text_size"
            android:textColor="@android:color/white"
            android:id="@+id/cb_reject_batch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reject batch"
            android:layout_below="@+id/batch_name"
            android:layout_alignParentLeft="true"
            android:buttonTint="@color/white"/>
        <CheckBox
            android:textSize="@dimen/textview_text_size"
            android:textColor="@android:color/white"
            android:id="@+id/cb_select_batch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select batch"
            android:layout_below="@+id/cb_reject_batch"
            android:layout_alignParentLeft="true"
            android:buttonTint="@color/white"/>
        <TextView
            android:textSize="@dimen/textview_text_size"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/survey_count_continue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total: 44"
            android:layout_toRightOf="@+id/batch_name"
            android:layout_below="@+id/ll_data"
            android:layout_alignParentRight="true"
            android:layout_toEndOf="@+id/batch_name"/>
        <ImageView
            android:id="@+id/btn_expand_toggle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/plus"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</RelativeLayout>
