<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_5sdp">
        <TextView
            android:textSize="@dimen/_12sdp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:id="@+id/tv_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enter_your_cnic"
            android:textAlignment="center"/>
        <TextView
            android:textSize="@dimen/_12sdp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:id="@+id/tv_app_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp15"
            android:text="@string/enter_your_cnic_urdu"
            android:textAlignment="center"/>
        <EditText
            android:textSize="@dimen/sp12"
            android:textColor="@color/black"
            android:textColorHint="@color/hintColor"
            android:gravity="start|center_vertical"
            android:id="@+id/et_cnic"
            android:background="@drawable/edit_text_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp50"
            android:hint="_____-_______-_"
            android:maxLines="1"
            android:maxLength="13"
            android:digits="0123456789"
            android:inputType="number"
            android:paddingStart="@dimen/dp10"
            android:paddingEnd="@dimen/dp10"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:weightSum="1">
            <RadioGroup
                android:orientation="horizontal"
                android:id="@+id/rg_gender"
                android:paddingRight="20dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8">
                <RadioButton
                    android:textSize="@dimen/_12sdp"
                    android:id="@+id/rb_male"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:text="@string/male"
                    android:buttonTint="@color/colorButtonGreen"/>
                <RadioButton
                    android:textSize="@dimen/_12sdp"
                    android:id="@+id/rb_female"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:text="@string/female"
                    android:buttonTint="@color/colorButtonRed"/>
                <RadioButton
                    android:textSize="@dimen/_12sdp"
                    android:id="@+id/rb_trans_gender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:text="@string/transgender"
                    android:buttonTint="@color/colorButtonYellow"/>
            </RadioGroup>
            <TextView
                android:textSize="@dimen/_12sdp"
                android:layout_gravity="center_vertical"
                android:paddingRight="20dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/gender"
                android:layout_weight="0.2"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp30">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/btn_ok"
                android:background="@drawable/login_button_bk"
                android:layout_width="@dimen/dp100"
                android:layout_height="@dimen/dp35"
                android:layout_marginRight="@dimen/dp10"
                android:layout_marginBottom="@dimen/dp20"
                android:text="Ok"
                android:layout_marginEnd="@dimen/dp10"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
