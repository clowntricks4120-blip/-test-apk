<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/line"
        android:layout_alignParentTop="true"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/line">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingTop="@dimen/activity_vertical_margin"
            android:paddingRight="@dimen/activity_horizontal_margin"
            android:paddingBottom="@dimen/activity_vertical_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:textSize="@dimen/textview_text_size"
                android:textColor="@android:color/black"
                android:id="@+id/Edittext_name"
                android:background="@drawable/edit_text_bg"
                android:padding="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:hint="Name"
                android:maxLines="1"
                android:singleLine="true"
                android:maxLength="20"
                android:digits=" qwertzuiopasdfghjklyxcvbnmQWERTYUIOPASDFGHJKLZXCVBNM"
                android:imeOptions="actionNext"/>
            <EditText
                android:textSize="@dimen/textview_text_size"
                android:textColor="@android:color/black"
                android:id="@+id/Edittext_contact"
                android:background="@drawable/edit_text_bg"
                android:padding="5dp"
                android:nextFocusDown="@+id/Edittext_cnic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:hint="Contact Number"
                android:maxLines="1"
                android:maxLength="@integer/phone_number_length"
                android:digits="0123456789"
                android:inputType="phone"
                android:imeOptions="actionNext"/>
            <EditText
                android:textSize="@dimen/textview_text_size"
                android:textColor="@android:color/black"
                android:id="@+id/Edittext_cnic"
                android:background="@drawable/edit_text_bg"
                android:padding="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:hint="CNIC"
                android:maxLines="1"
                android:digits="0123456789"
                android:inputType="numberDecimal"
                android:imeOptions="actionDone"/>
            <ImageView
                android:id="@+id/imgbtn_surveyer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:src="@drawable/holder_surveyor"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"/>
            <Button
                android:textSize="@dimen/textview_text_size"
                android:textColor="@android:color/white"
                android:id="@+id/btn_save"
                android:background="@color/colorPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Save"/>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
