<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/heading_text_size"
        android:textColor="@color/white"
        android:gravity="center_horizontal"
        android:id="@+id/tv_header"
        android:background="@color/colorButtonBlue"
        android:padding="@dimen/header_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/heading_roster"
        android:layout_alignParentTop="true"/>
    <ProgressBar
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_header"
        android:layout_centerHorizontal="true"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/my_recycler_view"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/tv_help"
        android:layout_below="@+id/tv_header"/>
    <TextView
        android:textSize="@dimen/textview_text_size"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/tv_help"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/roster_help_text"
        android:layout_above="@+id/ll_btn"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_5sdp"
        android:weightSum="1"
        android:layout_alignParentBottom="true">
        <Button
            android:textSize="@dimen/textview_text_size"
            android:textColor="@android:color/white"
            android:id="@+id/btn_add_nadra"
            android:background="@color/colorButtonRed"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:text="@string/addnadra"
            android:layout_weight="1"
            android:textAlignment="center"/>
        <Button
            android:textSize="@dimen/textview_text_size"
            android:textColor="@android:color/white"
            android:id="@+id/btn_add_more"
            android:background="@color/colorButtonRed"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:text="@string/addmore"
            android:layout_weight="1"
            android:textAlignment="center"/>
    </LinearLayout>
</RelativeLayout>
