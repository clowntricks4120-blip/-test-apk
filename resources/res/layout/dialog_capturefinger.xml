<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:id="@+id/mainCard"
        android:padding="24dp"
        android:layout_width="600dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:backgroundTint="@android:color/white"
        app:cardCornerRadius="28dp"
        app:cardElevation="12dp"
        app:strokeWidth="1dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/rlMain"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_centerHorizontal="true">
                <TextView
                    android:textSize="18dp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/hand_selection_textView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="برائے مہربانی جواب دہندہ کے ہاتھ کا انتخاب کریں"
                    android:layout_centerHorizontal="true"/>
                <RelativeLayout
                    android:id="@+id/rlHandIndex"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_below="@+id/hand_selection_textView"
                    android:layout_centerHorizontal="true">
                    <RadioGroup
                        android:layout_gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/rg_hands"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <RadioButton
                            android:textSize="@dimen/radiobutton_text_size"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:id="@+id/left_hand"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="@dimen/_20sdp"
                            android:checked="false"
                            android:text="بایاں ہاتھ"/>
                        <RadioButton
                            android:textSize="@dimen/radiobutton_text_size"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:id="@+id/right_hand"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/_20sdp"
                            android:checked="true"
                            android:text="داہنا ہاتھ"/>
                    </RadioGroup>
                </RelativeLayout>
                <ImageView
                    android:textSize="@dimen/_14sdp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:id="@+id/finger_selection_textView"
                    android:layout_width="250dp"
                    android:layout_height="200dp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:src="@drawable/hand_image"
                    android:text="برائے مہربانی انگلی کا انتخاب کریں۔"
                    android:layout_below="@+id/rlHandIndex"
                    android:layout_centerHorizontal="true"/>
                <Spinner
                    android:id="@+id/finger_index_spinner"
                    android:background="@drawable/spinner_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:layout_below="@+id/finger_selection_textView"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rlfingerMain"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_centerHorizontal="true">
                <TextView
                    android:textSize="24dp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/hand_selection_heading_textView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="داہنے ہاتھ کا انگوٹھا لگائیں"
                    android:layout_centerHorizontal="true"/>
                <RadioGroup
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@+id/radio_group_fingers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_below="@+id/hand_selection_heading_textView"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:gravity="center"
                android:id="@+id/rlFingerImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="10dp"
                android:layout_centerHorizontal="true">
                <FrameLayout
                    android:layout_gravity="center"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_marginTop="10dp">
                    <View
                        android:id="@+id/scan_ring"
                        android:background="@drawable/ring_background"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/imageview_fp"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:src="@drawable/fingerprint_scan"
                        android:backgroundTint="#00bfa5"/>
                </FrameLayout>
            </RelativeLayout>
            <Button
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:id="@+id/select_finger"
                android:background="@drawable/round_button"
                android:paddingLeft="@dimen/_20sdp"
                android:paddingRight="@dimen/_20sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:text="Capture"
                android:layout_below="@+id/rlFingerImage"
                android:layout_centerHorizontal="true"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
