<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/backgroundColor"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_actionbar"
        android:background="@color/actionbarColor"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_30sdp">
        <ImageView
            android:id="@+id/iv_back"
            android:padding="5dp"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_marginLeft="@dimen/dp10"
            android:src="@drawable/ic_back"
            android:layout_alignParentLeft="true"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/dp10"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/_10sdp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/duplicate_cnic"
            android:layout_centerInParent="true"
            android:textAllCaps="true"/>
    </RelativeLayout>
    <ScrollView
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_9sdp"
                android:weightSum="2">
                <TextView
                    android:textSize="@dimen/_10sdp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:id="@+id/tv_family_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="First Family"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:textAlignment="center"/>
                <TextView
                    android:textSize="@dimen/_10sdp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:id="@+id/tv_family_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Second Family"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:textAlignment="center"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_9sdp"
                android:layout_marginRight="@dimen/_9sdp"
                android:weightSum="2">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/family_button1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="@dimen/sp16"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/btn_F1update"
                        android:background="@drawable/login_button_bk"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp45"
                        android:text="Select Family"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/family_button2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="@dimen/sp16"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/btn_F2update"
                        android:background="@drawable/login_button_bk"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp45"
                        android:text="Select Family"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_9sdp"
                android:weightSum="2">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_family1"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:reverseLayout="true"
                    app:stackFromEnd="true"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_family2"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:reverseLayout="true"
                    app:stackFromEnd="true"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_9sdp"
                android:layout_marginRight="@dimen/_9sdp"
                android:weightSum="1">
                <TextView
                    android:textSize="@dimen/_10sdp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:id="@+id/tv_nadra_family"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="NADRA Family"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:textAlignment="center"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_9sdp">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_family3"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:reverseLayout="true"
                    app:stackFromEnd="true"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
