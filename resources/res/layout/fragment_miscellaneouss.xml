<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/heading_text_size"
        android:textColor="@android:color/white"
        android:gravity="center_horizontal"
        android:background="@color/brownColor"
        android:padding="@dimen/header_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/heading_miscellineous"/>
    <TextView
        android:textSize="@dimen/heading_text_size"
        android:gravity="right"
        android:id="@+id/tv_time_remaining"
        android:padding="@dimen/header_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Time Remaining : 0"/>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingTop="@dimen/activity_vertical_margin"
            android:paddingRight="@dimen/activity_horizontal_margin"
            android:paddingBottom="@dimen/activity_vertical_margin"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_mis_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/textview_text_size"
                    android:layout_gravity="center_vertical"
                    android:paddingRight="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/question_defence_job"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:weightSum="1">
                    <RadioGroup
                        android:layout_gravity="right"
                        android:orientation="horizontal"
                        android:id="@+id/rg_defense_job"
                        android:paddingRight="20dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6">
                        <RadioButton
                            android:textSize="@dimen/textview_text_size"
                            android:id="@+id/rb_defense_job_yes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:text="@string/yes"
                            android:buttonTint="@color/colorButtonGreen"/>
                        <RadioButton
                            android:textSize="@dimen/textview_text_size"
                            android:id="@+id/rb_defense_job_no"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/no"
                            android:buttonTint="@color/colorButtonRed"/>
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_mis_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/textview_text_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/question_taken_loan"/>
                <Spinner
                    android:id="@+id/sp_loan"
                    android:background="@drawable/spinner_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="@string/select_any"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_mis_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/textview_text_size"
                    android:layout_gravity="center_vertical"
                    android:paddingRight="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/question_financial_assistance"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:weightSum="1">
                    <RadioGroup
                        android:layout_gravity="right"
                        android:orientation="horizontal"
                        android:id="@+id/rg_financialAssistance"
                        android:paddingRight="20dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6">
                        <RadioButton
                            android:textSize="@dimen/textview_text_size"
                            android:id="@+id/rb_financialAssistance_yes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:text="@string/yes"
                            android:buttonTint="@color/colorButtonGreen"/>
                        <RadioButton
                            android:textSize="@dimen/textview_text_size"
                            android:id="@+id/rb_financialAssistance_no"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/no"
                            android:buttonTint="@color/colorButtonRed"/>
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_mis_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/textview_text_size"
                    android:paddingRight="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/question_migration"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:weightSum="1">
                    <RadioGroup
                        android:orientation="horizontal"
                        android:id="@+id/rg_migration"
                        android:paddingRight="20dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6">
                        <RadioButton
                            android:textSize="@dimen/textview_text_size"
                            android:id="@+id/rb_migration_yes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:text="@string/yes"
                            android:buttonTint="@color/colorButtonGreen"/>
                        <RadioButton
                            android:textSize="@dimen/textview_text_size"
                            android:id="@+id/rb_migration_no"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/no"
                            android:buttonTint="@color/colorButtonRed"/>
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_mis_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/textview_text_size"
                    android:layout_gravity="center_vertical"
                    android:paddingRight="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/question_infant_death"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:weightSum="1">
                    <RadioGroup
                        android:orientation="horizontal"
                        android:id="@+id/rg_infantDeath"
                        android:paddingRight="20dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6">
                        <RadioButton
                            android:textSize="@dimen/textview_text_size"
                            android:id="@+id/rb_infantDeath_yes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:text="@string/yes"
                            android:buttonTint="@color/colorButtonGreen"/>
                        <RadioButton
                            android:textSize="@dimen/textview_text_size"
                            android:id="@+id/rb_infantDeath_no"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/no"
                            android:buttonTint="@color/colorButtonRed"/>
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_mis_6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/textview_text_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/question_resolve_complaints"/>
                <Spinner
                    android:id="@+id/sp_resolveComplaint"
                    android:background="@drawable/spinner_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="@string/select_any"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_mis_7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/textview_text_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/question_resolve_complaints_govt"/>
                <Spinner
                    android:id="@+id/sp_resolveComplaint_govt"
                    android:background="@drawable/spinner_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="@string/select_any"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_mis_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/textview_text_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/question_satisfaction_level"/>
                <Spinner
                    android:id="@+id/sp_levelSatisfaction"
                    android:background="@drawable/spinner_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="@string/select_any"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
