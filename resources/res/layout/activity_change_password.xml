<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#f1f5f9"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="32dp"
        android:paddingBottom="48dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#ffffff"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="36dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageButton
                        android:id="@+id/btnBack"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@android:drawable/ic_menu_revert"
                        android:layout_centerVertical="true"
                        android:contentDescription="Back"
                        android:layout_alignParentStart="true"
                        app:tint="#1e293b"/>
                    <LinearLayout
                        android:background="#e0e7ff"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@android:drawable/ic_lock_lock"
                            app:tint="#1a56db"/>
                        <TextView
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#1a56db"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GOVERNMENT SECURE CREDENTIAL PORTAL"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>
                </RelativeLayout>
                <TextView
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#0f172a"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Change Account Password"/>
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#475569"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="اکاؤنٹ پاس ورڈ کی تجدید و تبدیلی"/>
                <View
                    android:background="#f1f5f9"
                    android:layout_width="match_parent"
                    android:layout_height="1.5dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layoutStep1Form"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1e293b"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CNIC / Username  •  شناختی کارڈ نمبر"/>
                    <EditText
                        android:textSize="17sp"
                        android:textColor="#0f172a"
                        android:id="@+id/etCnic"
                        android:background="@drawable/bg_otp_box"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:layout_marginTop="8dp"
                        android:hint="e.g. 1410203560725"
                        android:digits="0123456789-"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"/>
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1e293b"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Old Password  •  پرانا پاس ورڈ"/>
                    <FrameLayout
                        android:background="@drawable/bg_otp_box"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:layout_marginTop="8dp">
                        <EditText
                            android:textSize="17sp"
                            android:textColor="#0f172a"
                            android:id="@+id/etOldPassword"
                            android:background="@android:color/transparent"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:hint="e.g. Polka!965"
                            android:digits="@string/digits_new"
                            android:inputType="textPassword"
                            android:paddingStart="18dp"
                            android:paddingEnd="52dp"/>
                        <ImageView
                            android:layout_gravity="end|center_vertical"
                            android:id="@+id/ivToggleOldPassword"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="13dp"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_width="48dp"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_eye_hidden"
                            android:contentDescription="Toggle password visibility"
                            app:tint="#64748b"/>
                    </FrameLayout>
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1e293b"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="New Password  •  نیا پاس ورڈ"/>
                    <FrameLayout
                        android:background="@drawable/bg_otp_box"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:layout_marginTop="8dp">
                        <EditText
                            android:textSize="17sp"
                            android:textColor="#0f172a"
                            android:id="@+id/etNewPassword"
                            android:background="@android:color/transparent"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:hint="e.g. Polka!965"
                            android:digits="@string/digits_new"
                            android:inputType="textPassword"
                            android:paddingStart="18dp"
                            android:paddingEnd="52dp"/>
                        <ImageView
                            android:layout_gravity="end|center_vertical"
                            android:id="@+id/ivToggleNewPassword"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="13dp"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_width="48dp"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_eye_hidden"
                            android:contentDescription="Toggle password visibility"
                            app:tint="#64748b"/>
                    </FrameLayout>
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1e293b"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Confirm Password  •  پاس ورڈ کی تصدیق"/>
                    <FrameLayout
                        android:background="@drawable/bg_otp_box"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:layout_marginTop="8dp">
                        <EditText
                            android:textSize="17sp"
                            android:textColor="#0f172a"
                            android:id="@+id/etConfirmPassword"
                            android:background="@android:color/transparent"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:hint="Re-enter new password"
                            android:digits="@string/digits_new"
                            android:inputType="textPassword"
                            android:paddingStart="18dp"
                            android:paddingEnd="52dp"/>
                        <ImageView
                            android:layout_gravity="end|center_vertical"
                            android:id="@+id/ivToggleConfirmPassword"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="13dp"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_width="48dp"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_eye_hidden"
                            android:contentDescription="Toggle confirm password visibility"
                            app:tint="#64748b"/>
                    </FrameLayout>
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        app:cardBackgroundColor="#f8fafc"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">
                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="18dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#334155"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Password Requirements (سیکیورٹی شرائط):"/>
                            <TextView
                                android:textSize="14sp"
                                android:textColor="#64748b"
                                android:id="@+id/tvRuleLength"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="• 8 to 12 characters long"/>
                            <TextView
                                android:textSize="14sp"
                                android:textColor="#64748b"
                                android:id="@+id/tvRuleUpper"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="• At least 1 Uppercase letter (A-Z)"/>
                            <TextView
                                android:textSize="14sp"
                                android:textColor="#64748b"
                                android:id="@+id/tvRuleNumber"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="• At least 1 Number (0-9)"/>
                            <TextView
                                android:textSize="14sp"
                                android:textColor="#64748b"
                                android:id="@+id/tvRuleSpecial"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="• At least 1 Special character (@#$%!*)"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <androidx.appcompat.widget.AppCompatButton
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#ffffff"
                        android:id="@+id/btnProceedToVerification"
                        android:background="@drawable/bg_primary_button"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="28dp"
                        android:text="CONTINUE  •  تصدیق کے لیے آگے بڑھیں"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layoutStep2Otp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#f8fafc"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">
                        <LinearLayout
                            android:orientation="vertical"
                            android:padding="20dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <ImageView
                                    android:id="@+id/ivOtpChannelIcon"
                                    android:background="#eff6ff"
                                    android:padding="12dp"
                                    android:layout_width="52dp"
                                    android:layout_height="52dp"
                                    android:src="@android:drawable/stat_sys_phone_call"
                                    app:tint="#1a56db"/>
                                <LinearLayout
                                    android:orientation="vertical"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="16dp">
                                    <TextView
                                        android:textSize="18sp"
                                        android:textStyle="bold"
                                        android:textColor="#0f172a"
                                        android:id="@+id/tvOtpChannelTitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Mobile SIM OTP Verification"/>
                                    <TextView
                                        android:textSize="14sp"
                                        android:textColor="#64748b"
                                        android:id="@+id/tvOtpTargetCnic"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="CNIC / ID: 1410203560725"/>
                                </LinearLayout>
                            </LinearLayout>
                            <TextView
                                android:textSize="15sp"
                                android:textColor="#334155"
                                android:id="@+id/tvOtpChannelMessageEn"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:text="A 6-digit OTP has been sent to your registered number."/>
                            <TextView
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#0f392b"
                                android:id="@+id/tvOtpChannelMessageUr"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="آپ کے رجسٹرڈ موبائل سم پر 6 ہندسوں کا کوڈ بھیجا گیا ہے۔"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp">
                        <EditText
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:textColor="#0f172a"
                            android:gravity="center"
                            android:id="@+id/otpBox1"
                            android:background="@drawable/bg_otp_box"
                            android:layout_width="65dp"
                            android:layout_height="75dp"
                            android:layout_margin="6dp"
                            android:maxLength="1"
                            android:inputType="number"/>
                        <EditText
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:textColor="#0f172a"
                            android:gravity="center"
                            android:id="@+id/otpBox2"
                            android:background="@drawable/bg_otp_box"
                            android:layout_width="65dp"
                            android:layout_height="75dp"
                            android:layout_margin="6dp"
                            android:maxLength="1"
                            android:inputType="number"/>
                        <EditText
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:textColor="#0f172a"
                            android:gravity="center"
                            android:id="@+id/otpBox3"
                            android:background="@drawable/bg_otp_box"
                            android:layout_width="65dp"
                            android:layout_height="75dp"
                            android:layout_margin="6dp"
                            android:maxLength="1"
                            android:inputType="number"/>
                        <EditText
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:textColor="#0f172a"
                            android:gravity="center"
                            android:id="@+id/otpBox4"
                            android:background="@drawable/bg_otp_box"
                            android:layout_width="65dp"
                            android:layout_height="75dp"
                            android:layout_margin="6dp"
                            android:maxLength="1"
                            android:inputType="number"/>
                        <EditText
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:textColor="#0f172a"
                            android:gravity="center"
                            android:id="@+id/otpBox5"
                            android:background="@drawable/bg_otp_box"
                            android:layout_width="65dp"
                            android:layout_height="75dp"
                            android:layout_margin="6dp"
                            android:maxLength="1"
                            android:inputType="number"/>
                        <EditText
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:textColor="#0f172a"
                            android:gravity="center"
                            android:id="@+id/otpBox6"
                            android:background="@drawable/bg_otp_box"
                            android:layout_width="65dp"
                            android:layout_height="75dp"
                            android:layout_margin="6dp"
                            android:maxLength="1"
                            android:inputType="number"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp">
                        <TextView
                            android:textSize="15sp"
                            android:textColor="#64748b"
                            android:id="@+id/tvTimerPrefix"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resend code in "/>
                        <TextView
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#0f172a"
                            android:id="@+id/tvTimerCountdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:60"/>
                        <TextView
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#1a56db"
                            android:id="@+id/btnResendOtp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resend OTP / دوبارہ کوڈ بھیجیں"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatButton
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#ffffff"
                        android:id="@+id/btnSubmitPasswordReset"
                        android:background="@drawable/bg_primary_button"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="32dp"
                        android:text="VERIFY &amp; UPDATE PASSWORD  •  پاس ورڈ تبدیل کریں"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#64748b"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/btnBackToForm"
                        android:padding="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Modify Password Details / تبدیل کریں"/>
                </LinearLayout>
                <ProgressBar
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/pbLoading"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
