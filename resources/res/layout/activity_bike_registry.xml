<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#eaf3ec"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#1e1e1e"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bike Registration Detail"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:textSize="26sp"
                    android:gravity="center"
                    android:id="@+id/etCnic"
                    android:background="@drawable/bg_input_field"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginBottom="20dp"
                    android:hint="Enter CNIC (13 digits)"
                    android:maxLength="15"
                    android:inputType="number"/>
                <Button
                    android:textSize="26sp"
                    android:textColor="#ffffff"
                    android:id="@+id/btnVerify"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="10dp"
                    android:text="Verify"
                    android:backgroundTint="#0a8f3c"/>
                <ProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/progress_loading"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layoutAddBike"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RadioGroup
                android:orientation="horizontal"
                android:id="@+id/rgBikeAvailable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <RadioButton
                    android:textStyle="bold"
                    android:textColor="#0a8f3c"
                    android:gravity="center"
                    android:id="@+id/rbYes"
                    android:background="@drawable/radio_selected_bg"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:button="@null"
                    android:text="Bike Available"
                    android:layout_weight="1"/>
                <View
                    android:layout_width="5dp"
                    android:layout_height="1dp"/>
                <RadioButton
                    android:textColor="#555"
                    android:gravity="center"
                    android:id="@+id/rbNo"
                    android:background="@drawable/radio_unselected_bg"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:button="@null"
                    android:text="No Bike"
                    android:layout_weight="1"/>
            </RadioGroup>
            <TextView
                android:textSize="14sp"
                android:textColor="#0a8f3c"
                android:id="@+id/tvStatus"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="✔ Data is up-to-date"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerBikes"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/phoneParent"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:textSize="26sp"
                    android:gravity="left"
                    android:id="@+id/etPhone"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginBottom="20dp"
                    android:hint="Enter Phone Number"
                    android:maxLength="12"
                    android:digits="0123456789"
                    android:inputType="number"/>
                <Spinner
                    android:textSize="26sp"
                    android:entries="@array/banksBike"
                    android:id="@+id/spBank"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"/>
                <EditText
                    android:textSize="26sp"
                    android:gravity="left"
                    android:id="@+id/etAcc"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginBottom="20dp"
                    android:hint="Enter Account Number"
                    android:maxLength="15"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="end|bottom"
                android:orientation="vertical"
                android:id="@+id/fabAddBikeParent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="10dp">
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:layout_gravity="center"
                    android:id="@+id/fabAddBike"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@android:drawable/ic_input_add"
                    android:backgroundTint="#0a8f3c"/>
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#0a8f3c"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Bike"/>
            </LinearLayout>
            <Button
                android:textSize="26sp"
                android:textColor="#ffffff"
                android:id="@+id/btnSubmit"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="10dp"
                android:text="Submit"
                android:backgroundTint="#0a8f3c"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
