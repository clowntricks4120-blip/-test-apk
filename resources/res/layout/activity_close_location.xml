<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/colorBGGREY"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/line"/>
    <TextView
        android:textSize="@dimen/heading_text_size"
        android:textColor="@android:color/white"
        android:gravity="center_horizontal"
        android:background="@color/colorSmallHeading"
        android:padding="@dimen/header_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/new_location"/>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingTop="@dimen/activity_vertical_margin"
            android:paddingRight="@dimen/activity_horizontal_margin"
            android:paddingBottom="@dimen/activity_vertical_margin"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:weightSum="1">
                <RadioGroup
                    android:orientation="horizontal"
                    android:id="@+id/rg_region"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.6">
                    <RadioButton
                        android:textSize="@dimen/textview_text_size"
                        android:id="@+id/rb_urban"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:text="@string/urban"
                        android:buttonTint="@color/colorButtonGreen"/>
                    <RadioButton
                        android:textSize="@dimen/textview_text_size"
                        android:id="@+id/rb_rural"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:text="@string/rural"
                        android:buttonTint="@color/colorButtonRed"/>
                </RadioGroup>
                <TextView
                    android:textSize="@dimen/textview_text_size"
                    android:textColor="@android:color/black"
                    android:layout_gravity="center_vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/region"
                    android:layout_weight="0.4"/>
            </LinearLayout>
            <Spinner
                android:id="@+id/sp_province"
                android:background="@drawable/spinner_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"/>
            <Spinner
                android:id="@+id/sp_district"
                android:background="@drawable/spinner_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"/>
            <Spinner
                android:id="@+id/sp_tehsil"
                android:background="@drawable/spinner_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"/>
            <Spinner
                android:id="@+id/sp_uc"
                android:background="@drawable/spinner_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"/>
            <Spinner
                android:id="@+id/sp_village_name"
                android:background="@drawable/spinner_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"/>
            <Button
                android:textSize="@dimen/textview_text_size"
                android:textColor="@android:color/white"
                android:id="@+id/btn_close_locality"
                android:background="@color/colorButtonGreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Close Locality"
                android:textAlignment="center"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
