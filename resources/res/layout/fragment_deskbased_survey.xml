<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/heading_text_size"
        android:textColor="@android:color/white"
        android:gravity="center_horizontal"
        android:background="@color/colorPrimary"
        android:padding="@dimen/header_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Deskbased Survey"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/textview_text_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Were you Surveyed during Desk Based interview?"/>
            <RadioGroup
                android:orientation="horizontal"
                android:id="@+id/rg_desk_based"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton
                    android:textSize="@dimen/textview_text_size"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/rb_desk_based_yes"
                    android:padding="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/yes"
                    android:layout_weight="0.5"
                    android:buttonTint="@color/colorButtonGreen"/>
                <RadioButton
                    android:textSize="@dimen/textview_text_size"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/rb_desk_based_no"
                    android:padding="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/no"
                    android:layout_weight="0.5"
                    android:buttonTint="@color/colorButtonRed"/>
            </RadioGroup>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_lost_receipt"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/textview_text_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Have you got the receipt?"/>
            <RadioGroup
                android:orientation="horizontal"
                android:id="@+id/rg_receipt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton
                    android:textSize="@dimen/textview_text_size"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/rb_receipt_yes"
                    android:padding="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/yes"
                    android:layout_weight="0.5"
                    android:buttonTint="@color/colorButtonGreen"/>
                <RadioButton
                    android:textSize="@dimen/textview_text_size"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/rb_receipt_no"
                    android:padding="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/no"
                    android:layout_weight="0.5"
                    android:buttonTint="@color/colorButtonRed"/>
            </RadioGroup>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_qr_code"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:enabled="false"
                android:textSize="@dimen/textview_text_size"
                android:id="@+id/previous_form_no"
                android:background="@drawable/edit_text_bg"
                android:paddingLeft="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/activity_vertical_margin"
                android:hint="Previous Form Number"
                android:digits="@string/digits"/>
            <Button
                android:textSize="@dimen/textview_text_size"
                android:textColor="@android:color/white"
                android:id="@+id/btn_qr_code"
                android:background="@color/colorPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="SCAN QR CODE"
                android:textAlignment="center"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
