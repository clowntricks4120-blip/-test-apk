<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    app:cardBackgroundColor="@color/cropCVBg">
    <LinearLayout
        android:orientation="vertical"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <CheckBox
            android:textSize="@dimen/subheading_text_size"
            android:gravity="center_vertical"
            android:id="@+id/cb_selected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:button="@null"
            android:text="asdasdadasdasdasdsa"
            android:drawableRight="?android:attr/listChoiceIndicatorMultiple"
            android:drawableTint="@color/colorButtonGreen"/>
        <Button
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_gravity="right"
            android:id="@+id/btn_add_detail"
            android:background="@color/colorButtonRed"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detail"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
