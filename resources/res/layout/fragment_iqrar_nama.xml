<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#f4f6f9"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:textDirection="rtl"
    android:layoutDirection="rtl">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/colorButtonOrange"
        app:cardCornerRadius="0dp"
        app:cardElevation="6dp">
        <TextView
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/tv_header"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اقرار نامہ"
            android:fontFamily="@font/jameel_noori_nastaleeq"/>
    </androidx.cardview.widget.CardView>
    <ScrollView
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:contentPadding="20dp">
                <TextView
                    android:textSize="18sp"
                    android:textColor="#222222"
                    android:id="@+id/tv_main_declaration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="میں ـــــــــــــــــــــــــــــــــــ، اس بات کا اقرار کرتا/کرتی ہوں کہ اس سروے کے دوران فراہم کردہ تمام معلومات میرے مطابق بالکل درست ہیں۔ مجھے اس بات کا علم ہے کہ اگر مہیا کردہ معلومات غلط ثابت ہوں تو:"
                    android:lineSpacingExtra="8dp"
                    android:fontFamily="@font/jameel_noori_nastaleeq"/>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#fff8f5"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:contentPadding="20dp">
                <TextView
                    android:textSize="17sp"
                    android:textColor="#d32f2f"
                    android:id="@+id/tv_conditions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1۔ میرے خلاف قانون کے مطابق کارروائی کی جا سکتی ہے۔\102۔ مجھے حکومت کے کسی بھی پروگرام کے تحت ملنے والی مالی معاونت کے لیے نااہل قرار دیا جا سکتا ہے۔\103۔ مجھے حاصل شدہ تمام فوائد (نقد یا غیر نقد) واپس لیے جا سکتے ہیں۔"
                    android:lineSpacingExtra="8dp"
                    android:fontFamily="@font/jameel_noori_nastaleeq"/>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:contentPadding="20dp">
                <TextView
                    android:textSize="18sp"
                    android:textColor="#222222"
                    android:id="@+id/tv_permissions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="اور میں یہ اجازت دیتا/دیتی ہوں کہ BISP کا مجاز نمائندہ:\101۔ میرے گھر آ کر فراہم کردہ معلومات کی تصدیق کر سکتا ہے۔\102۔ میرے BISP کے ڈیجیٹل اکاؤنٹ یعنی میرے کھاتے میں رقم کی ادائیگی اور وصولی کی تفصیلات کا جائزہ لے سکتا ہے۔"
                    android:lineSpacingExtra="8dp"
                    android:fontFamily="@font/jameel_noori_nastaleeq"/>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="#f1f8e9"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:contentPadding="20dp">
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#2e7d32"
                    android:id="@+id/tv_verification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="تصدیق: میں یہ اقرار نامہ اپنی مرضی اور آزادانہ رضامندی بذریعہ بایومیٹرک سے دے رہا/رہی ہوں۔"
                    android:lineSpacingExtra="8dp"
                    android:fontFamily="@font/jameel_noori_nastaleeq"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
