<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/backgroundColor"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_actionbar"
        android:background="@color/actionbarColor"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_30sdp">
        <ImageView
            android:id="@+id/iv_back"
            android:padding="5dp"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_marginLeft="@dimen/dp10"
            android:src="@drawable/ic_back"
            android:layout_alignParentLeft="true"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/dp10"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/_10sdp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Disability"
            android:layout_centerInParent="true"
            android:textAllCaps="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_cnic"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_5sdp"
        android:layout_marginRight="@dimen/_5sdp"
        android:layout_below="@+id/rl_actionbar">
        <TextView
            android:textSize="@dimen/subheading_text_size"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:id="@+id/tv_heading_cnic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enter_your_cnic"
            android:textAlignment="center"/>
        <TextView
            android:textSize="@dimen/subheading_text_size"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:id="@+id/tv_app_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp15"
            android:text="@string/enter_your_cnic_urdu"
            android:textAlignment="center"/>
        <EditText
            android:textSize="@dimen/textview_text_size"
            android:textColor="@color/black"
            android:textColorHint="@color/hintColor"
            android:gravity="start|center_vertical"
            android:id="@+id/et_cnic"
            android:background="@drawable/edit_text_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            android:hint="_____-_______-_"
            android:maxLines="1"
            android:maxLength="13"
            android:digits="0123456789"
            android:inputType="number"
            android:paddingStart="@dimen/dp10"
            android:paddingEnd="@dimen/dp10"
            android:layout_marginStart="@dimen/dp10"
            android:layout_marginEnd="@dimen/dp10"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/btn_ok"
                android:background="@drawable/login_button_bk"
                android:layout_width="@dimen/dp100"
                android:layout_height="@dimen/dp35"
                android:layout_marginRight="@dimen/dp10"
                android:layout_marginBottom="@dimen/dp20"
                android:text="Ok"
                android:layout_marginEnd="@dimen/dp10"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_10sdp"
        android:layout_below="@+id/ll_cnic">
        <TextView
            android:textSize="@dimen/subheading_text_size"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:id="@+id/tv_ph_nno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_5sdp"
            android:text="Please Enter Your Phone #"
            android:textAlignment="center"/>
        <Spinner
            android:id="@+id/sp_networks"
            android:background="@drawable/spinner_bg"
            android:nextFocusDown="@+id/mobile_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"/>
        <EditText
            android:textSize="@dimen/textview_text_size"
            android:textColor="@color/black"
            android:textColorHint="@color/hintColor"
            android:gravity="start|center_vertical"
            android:id="@+id/et_phone"
            android:background="@drawable/edit_text_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            android:hint="____-______"
            android:maxLines="1"
            android:maxLength="11"
            android:digits="0123456789"
            android:inputType="number"
            android:paddingStart="@dimen/dp10"
            android:paddingEnd="@dimen/dp10"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/subheading_text_size"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/btn_update"
        android:background="@drawable/login_button_bk"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp60"
        android:text="Update"
        android:layout_below="@+id/ll_spinner"
        android:layout_marginStart="@dimen/dp30"
        android:layout_marginEnd="@dimen/dp30"/>
</RelativeLayout>
