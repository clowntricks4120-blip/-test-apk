<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#ffffff"
    android:layout_width="600dp"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1e1e1e"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Add Bike"/>
        <EditText
            android:textSize="26sp"
            android:id="@+id/etBikeNumber"
            android:background="@drawable/edittext_bg"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Bike Number (BJU-645)"
            android:maxLength="8"
            android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-"/>
        <Spinner
            android:id="@+id/spRegistrationYear"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"/>
        <Spinner
            android:textSize="26sp"
            android:entries="@array/bike_types"
            android:id="@+id/spBikeType"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"/>
        <Spinner
            android:textSize="26sp"
            android:entries="@array/provinces"
            android:id="@+id/spProvince"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"/>
        <Spinner
            android:textSize="26sp"
            android:id="@+id/spOwner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layoutOtherOwner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:textSize="26sp"
                android:id="@+id/etOwnerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Enter Owner Name"/>
            <EditText
                android:textSize="26sp"
                android:id="@+id/etOwnerCnic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Enter Owner CNIC"
                android:maxLength="13"
                android:inputType="number"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <ImageView
                android:id="@+id/imgCamera"
                android:background="@drawable/ic_calender"
                android:visibility="gone"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginRight="10dp"/>
            <Button
                android:textSize="26sp"
                android:textColor="#0a8f3c"
                android:layout_gravity="bottom"
                android:id="@+id/btnCamera"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Take Bike Registration Photo (Optional)"
                android:backgroundTint="#eaf3ec"/>
        </LinearLayout>
        <Button
            android:textSize="26sp"
            android:textColor="#ffffff"
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:text="Save Bike"
            android:backgroundTint="#0a8f3c"/>
    </LinearLayout>
</ScrollView>
