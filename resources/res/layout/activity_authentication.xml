<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/backgroundColor"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_actionbar"
        android:background="@color/actionbarColor"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_30sdp">
        <TextView
            android:textSize="@dimen/_10sdp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login"
            android:layout_centerInParent="true"
            android:textAllCaps="true"/>
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/application_version_textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/_10sdp"
            android:text="App Version: "
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/login_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp20"
        android:layout_centerInParent="true">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/imgfound"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_110sdp"
            android:src="@drawable/app_logo_new"/>
        <TextView
            android:textSize="@dimen/sp20"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp20"
            android:text="@string/login"
            android:layout_marginStart="@dimen/dp10"
            android:layout_marginEnd="@dimen/dp10"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp">
            <TextView
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/black"
                android:gravity="start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Please Select any Option"
                android:layout_weight="1"
                android:textAllCaps="true"
                android:layout_marginStart="@dimen/dp10"
                android:layout_marginEnd="@dimen/dp10"/>
            <RadioGroup
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/radio_group"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <RadioButton
                    android:textSize="@dimen/sp14"
                    android:textColor="@color/black"
                    android:id="@+id/rdoCNIC"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="CNIC"/>
                <RadioButton
                    android:textSize="@dimen/sp14"
                    android:textColor="@color/black"
                    android:id="@+id/rdoPhn"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="Phone Number"/>
            </RadioGroup>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_phno"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp15"
                android:layout_marginStart="@dimen/dp10"
                android:layout_marginEnd="@dimen/dp10">
                <TextView
                    android:textSize="@dimen/_11sdp"
                    android:textColor="@color/black"
                    android:gravity="start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/phone_number"
                    android:layout_weight="1"
                    android:textAllCaps="true"
                    android:layout_marginStart="@dimen/dp10"
                    android:layout_marginEnd="@dimen/dp10"/>
                <TextView
                    android:textSize="@dimen/_11sdp"
                    android:textColor="@color/black"
                    android:gravity="start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/phone_number_urdu"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp10"
                    android:layout_marginEnd="@dimen/dp10"/>
            </LinearLayout>
            <EditText
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/black"
                android:textColorHint="@color/hintColor"
                android:gravity="start|center_vertical"
                android:id="@+id/et_phone"
                android:background="@drawable/edit_text_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_35sdp"
                android:layout_marginTop="@dimen/dp5"
                android:hint="03*****"
                android:maxLines="1"
                android:singleLine="true"
                android:maxLength="11"
                android:digits="0123456789"
                android:inputType="phone"
                android:paddingStart="@dimen/dp10"
                android:paddingEnd="@dimen/dp10"
                android:layout_marginStart="@dimen/dp10"
                android:layout_marginEnd="@dimen/dp10"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_cnic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp15"
                android:layout_marginStart="@dimen/dp10"
                android:layout_marginEnd="@dimen/dp10">
                <TextView
                    android:textSize="@dimen/sp14"
                    android:textColor="@color/black"
                    android:gravity="start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/cnic_no"
                    android:layout_weight="1"
                    android:textAllCaps="true"
                    android:layout_marginStart="@dimen/dp10"
                    android:layout_marginEnd="@dimen/dp10"/>
                <TextView
                    android:textSize="@dimen/sp14"
                    android:textColor="@color/black"
                    android:gravity="start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/cnic_no_urdu"
                    android:layout_weight="1"
                    android:fontFamily="@font/jameel_noori_nastaleeq"
                    android:layout_marginStart="@dimen/dp10"
                    android:layout_marginEnd="@dimen/dp10"/>
            </LinearLayout>
            <EditText
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/black"
                android:textColorHint="@color/hintColor"
                android:gravity="start|center_vertical"
                android:id="@+id/et_cnic"
                android:background="@drawable/edit_text_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_35sdp"
                android:layout_marginTop="@dimen/dp5"
                android:hint="_____-_______-_"
                android:maxLines="1"
                android:maxLength="13"
                android:digits="0123456789"
                android:inputType="number"
                android:paddingStart="@dimen/dp10"
                android:paddingEnd="@dimen/dp10"
                android:layout_marginStart="@dimen/dp10"
                android:layout_marginEnd="@dimen/dp10"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp15"
            android:layout_marginStart="@dimen/dp10"
            android:layout_marginEnd="@dimen/dp10">
            <TextView
                android:textSize="@dimen/sp14"
                android:textColor="@color/black"
                android:gravity="start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/password"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginStart="@dimen/dp10"
                android:layout_marginEnd="@dimen/dp10"/>
            <TextView
                android:textSize="@dimen/sp14"
                android:textColor="@color/black"
                android:gravity="start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/password_urdu"
                android:layout_weight="1"
                android:fontFamily="@font/jameel_noori_nastaleeq"
                android:layout_marginStart="@dimen/dp10"
                android:layout_marginEnd="@dimen/dp10"/>
        </LinearLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:textColorHint="@color/hintColor"
            android:id="@+id/etPasswordLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp5"
            android:layout_marginStart="@dimen/dp10"
            android:layout_marginEnd="@dimen/dp10"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/black">
            <com.google.android.material.textfield.TextInputEditText
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/black"
                android:gravity="start|center_vertical"
                android:id="@+id/et_password"
                android:background="@drawable/edit_text_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_35sdp"
                android:hint="[A-Z],[a-z],[0,9],special character."
                android:maxLines="1"
                android:digits="@string/digits_new"
                android:inputType="textPassword"
                android:paddingStart="@dimen/dp10"
                android:paddingEnd="@dimen/dp10"
                app:passwordToggleEnabled="true"/>
        </com.google.android.material.textfield.TextInputLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp15"
            android:layout_marginStart="@dimen/dp10"
            android:layout_marginEnd="@dimen/dp10">
            <TextView
                android:textSize="@dimen/sp13"
                android:textColor="@color/black"
                android:gravity="start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forgot_password"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginStart="@dimen/dp10"
                android:layout_marginEnd="@dimen/dp10"/>
            <TextView
                android:textSize="@dimen/sp13"
                android:textColor="@color/black"
                android:gravity="start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forgot_password_urdu"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp10"
                android:layout_marginEnd="@dimen/dp10"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/img_fp"
            android:visibility="gone"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_50sdp"
            android:layout_marginTop="@dimen/_20sdp"
            android:src="@drawable/fingerprint_scan"/>
        <TextView
            android:textSize="@dimen/sp16"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/btn_login"
            android:background="@drawable/login_button_bk"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginTop="@dimen/_20sdp"
            android:text="@string/login_button"
            android:layout_marginStart="@dimen/dp30"
            android:layout_marginEnd="@dimen/dp30"/>
        <TextView
            android:textSize="@dimen/sp16"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tvChangePassword"
            android:background="@drawable/login_button_bk"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            android:text="Change Password? / پاس ورڈ تبدیل کریں"
            android:layout_marginStart="@dimen/dp30"
            android:layout_marginEnd="@dimen/dp30"
            android:backgroundTint="@color/totalCountBG"/>
    </LinearLayout>
</RelativeLayout>
