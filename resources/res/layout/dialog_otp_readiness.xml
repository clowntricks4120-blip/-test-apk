<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#ffffff"
        app:cardCornerRadius="28dp"
        app:cardElevation="16dp">
        <LinearLayout
            android:orientation="vertical"
            android:padding="36dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:background="#ecfdf5"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/checkbox_on_background"
                    app:tint="#059669"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#059669"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BIOMETRIC &amp; LOGIN VERIFIED"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#0f172a"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Step 1 Completed Successfully"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#059669"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="پاس ورڈ اور بائیو میٹرک کی تصدیق کامیاب ہوگئی"/>
            <View
                android:background="#f1f5f9"
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="22dp"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#f8fafc"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="22dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/ivChannelIcon"
                            android:background="#eff6ff"
                            android:padding="12dp"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:src="@android:drawable/stat_sys_phone_call"
                            app:tint="#0f392b"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="18dp">
                            <TextView
                                android:textSize="19sp"
                                android:textStyle="bold"
                                android:textColor="#0f172a"
                                android:id="@+id/tvChannelTitleEn"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mobile SIM Verification (SMS)"/>
                            <TextView
                                android:textSize="16sp"
                                android:textColor="#334155"
                                android:id="@+id/tvChannelTitleUr"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="رجسٹرڈ سم (ایس ایم ایس) کے ذریعے تصدیق"/>
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:background="#e2e8f0"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="14dp"/>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="#334155"
                        android:id="@+id/tvChannelMessageEn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="We are now sending a 6-digit OTP to your registered SIM. Please make sure your mobile SIM network is active."
                        android:lineSpacingExtra="3dp"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="#1e293b"
                        android:id="@+id/tvChannelMessageUr"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="اب آپ کے رجسٹرڈ موبائل سم پر 6 ہندسوں کا او ٹی پی کوڈ بھیجا جا رہا ہے۔ براہ کرم اپنا موبائل نیٹ ورک فعال رکھیں۔"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:id="@+id/btnProceedSendOtp"
                android:background="@drawable/bg_primary_button"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="28dp"
                android:text="SEND OTP  •  او ٹی پی کوڈ بھیجیں"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#64748b"
                android:layout_gravity="center_horizontal"
                android:id="@+id/btnCancelOtpNotice"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Cancel  •  منسوخ کریں"/>
            <ProgressBar
                android:layout_gravity="center_horizontal"
                android:id="@+id/pbDialogLoading"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
