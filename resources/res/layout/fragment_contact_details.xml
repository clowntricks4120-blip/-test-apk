<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/heading_text_size"
        android:textColor="@android:color/white"
        android:gravity="center_horizontal"
        android:background="@color/orangeColor"
        android:padding="@dimen/header_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/heading_contact_details"/>
    <TextView
        android:textSize="@dimen/heading_text_size"
        android:gravity="right"
        android:id="@+id/tv_time_remaining"
        android:padding="@dimen/header_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Time Remaining : 0"/>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingTop="@dimen/activity_vertical_margin"
            android:paddingRight="@dimen/activity_horizontal_margin"
            android:paddingBottom="@dimen/fields_padding"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/subheading_text_size"
                    android:textColor="@android:color/black"
                    android:padding="@dimen/subheading_padding"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/a_subheading_contact_details"/>
                <Spinner
                    android:id="@+id/sp_province"
                    android:background="@drawable/spinner_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="Status of Visit"/>
                <Spinner
                    android:id="@+id/sp_district"
                    android:background="@drawable/spinner_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="Status of Visit"/>
                <Spinner
                    android:id="@+id/sp_tehsil"
                    android:background="@drawable/spinner_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="Status of Visit"/>
                <TextView
                    android:enabled="true"
                    android:textSize="@dimen/textview_text_size"
                    android:textColor="#000000"
                    android:gravity="right"
                    android:id="@+id/tv_temp_address"
                    android:background="@drawable/spinner_bg"
                    android:padding="10dp"
                    android:paddingLeft="30dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"/>
                <TextView
                    android:enabled="true"
                    android:textSize="@dimen/textview_text_size"
                    android:textColor="#000000"
                    android:gravity="right"
                    android:id="@+id/tv_per_address"
                    android:background="@drawable/spinner_bg"
                    android:padding="10dp"
                    android:paddingLeft="30dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"/>
                <Spinner
                    android:id="@+id/sp_uc"
                    android:background="@drawable/spinner_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="Status of Visit"/>
                <EditText
                    android:enabled="true"
                    android:textSize="@dimen/textview_text_size"
                    android:textColor="#000000"
                    android:gravity="right"
                    android:id="@+id/et_uc"
                    android:background="@drawable/edit_text_bg"
                    android:padding="10dp"
                    android:paddingLeft="30dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="@string/union_council_name"
                    android:digits="@string/digits_address"/>
                <Spinner
                    android:id="@+id/sp_village"
                    android:background="@drawable/spinner_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="Status of Visit"/>
                <EditText
                    android:enabled="true"
                    android:textSize="@dimen/textview_text_size"
                    android:textColor="#000000"
                    android:gravity="right"
                    android:id="@+id/et_village"
                    android:background="@drawable/edit_text_bg"
                    android:padding="10dp"
                    android:paddingLeft="30dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="@string/village_name"
                    android:maxLength="50"
                    android:digits="@string/digits_address"/>
                <Button
                    android:textSize="@dimen/textview_text_size"
                    android:textColor="@android:color/white"
                    android:id="@+id/btn_map"
                    android:background="@color/colorButtonOrange"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Maps"
                    android:textAlignment="center"/>
            </LinearLayout>
            <TextView
                android:background="@color/orangeColor"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"/>
            <TextView
                android:textSize="@dimen/subheading_text_size"
                android:textColor="@android:color/black"
                android:padding="@dimen/subheading_padding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/b_subheading_contact_details"/>
            <Spinner
                android:id="@+id/sp_visit_status"
                android:background="@drawable/spinner_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:hint="Status of Visit"/>
            <Spinner
                android:id="@+id/sp_structure_number"
                android:background="@drawable/spinner_bg"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:hint="Structure Number"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/ll_input_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:textSize="@dimen/enumerator_row_size"
                    android:id="@+id/ref_no"
                    android:background="@drawable/edit_text_bg"
                    android:visibility="gone"
                    android:nextFocusDown="@+id/sub_locality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="Survey firm Address Reference No"
                    android:maxLines="1"
                    android:maxLength="30"
                    android:digits="@string/digits"
                    android:inputType="text"
                    android:imeOptions="actionNext"/>
                <EditText
                    android:textSize="@dimen/enumerator_row_size"
                    android:id="@+id/sub_locality"
                    android:background="@drawable/edit_text_bg"
                    android:visibility="gone"
                    android:nextFocusDown="@+id/structure_no"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="Sub Locality"
                    android:maxLines="1"
                    android:maxLength="300"
                    android:digits="@string/digits"
                    android:inputType="textPostalAddress"
                    android:imeOptions="actionNext"/>
                <EditText
                    android:textSize="@dimen/enumerator_row_size"
                    android:id="@+id/et_block_code"
                    android:background="@drawable/edit_text_bg"
                    android:visibility="gone"
                    android:nextFocusDown="@+id/name_of_head"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="Block Code."
                    android:maxLines="1"
                    android:maxLength="1"
                    android:digits="1234"
                    android:inputType="number"
                    android:imeOptions="actionNext"/>
                <EditText
                    android:textSize="@dimen/enumerator_row_size"
                    android:id="@+id/et_enumeration_area_code"
                    android:background="@drawable/edit_text_bg"
                    android:visibility="gone"
                    android:nextFocusDown="@+id/name_of_head"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="Enumeration Area Code."
                    android:maxLines="1"
                    android:maxLength="4"
                    android:digits="@string/digits"
                    android:inputType="number"
                    android:imeOptions="actionNext"/>
                <EditText
                    android:textSize="@dimen/enumerator_row_size"
                    android:id="@+id/structure_no"
                    android:background="@drawable/edit_text_bg"
                    android:visibility="gone"
                    android:nextFocusDown="@+id/household_no"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="Structure No."
                    android:maxLines="1"
                    android:maxLength="5"
                    android:digits="@string/digits_str_num"
                    android:inputType="text"
                    android:imeOptions="actionNext"/>
                <EditText
                    android:textSize="@dimen/enumerator_row_size"
                    android:id="@+id/household_no"
                    android:background="@drawable/edit_text_bg"
                    android:visibility="gone"
                    android:nextFocusDown="@+id/name_of_head"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="Household No."
                    android:maxLines="1"
                    android:maxLength="30"
                    android:digits="@string/digits"
                    android:inputType="number"
                    android:imeOptions="actionNext"/>
                <EditText
                    android:textSize="@dimen/textview_text_size"
                    android:id="@+id/name_of_head"
                    android:background="@drawable/edit_text_bg"
                    android:visibility="gone"
                    android:nextFocusDown="@+id/address_of_house"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="@string/head_household"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:maxLength="30"
                    android:digits=" qwertzuiopasdfghjklyxcvbnmQWERTYUIOPASDFGHJKLZXCVBNM"
                    android:inputType="textPersonName"
                    android:imeOptions="actionNext"/>
                <EditText
                    android:textSize="@dimen/textview_text_size"
                    android:id="@+id/address_of_house"
                    android:background="@drawable/edit_text_bg"
                    android:nextFocusDown="@+id/mobile_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="@string/house_address"
                    android:maxLines="1"
                    android:maxLength="80"
                    android:digits="@string/digits_address"
                    android:imeOptions="actionNext"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:weightSum="1">
                    <RadioGroup
                        android:orientation="horizontal"
                        android:id="@+id/rg_region"
                        android:paddingRight="20dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6">
                        <RadioButton
                            android:enabled="true"
                            android:textSize="@dimen/textview_text_size"
                            android:id="@+id/rb_region_yes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:text="@string/urban"
                            android:buttonTint="@color/colorButtonGreen"/>
                        <RadioButton
                            android:enabled="true"
                            android:textSize="@dimen/textview_text_size"
                            android:id="@+id/rb_region_no"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:text="@string/rural"
                            android:buttonTint="@color/colorButtonRed"/>
                    </RadioGroup>
                    <TextView
                        android:textSize="@dimen/textview_text_size"
                        android:textColor="@android:color/darker_gray"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tv_region_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/region"
                        android:layout_weight="0.4"/>
                </LinearLayout>
                <EditText
                    android:textSize="@dimen/textview_text_size"
                    android:id="@+id/union_council_name"
                    android:background="@drawable/edit_text_bg"
                    android:visibility="gone"
                    android:nextFocusDown="@+id/village_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="@string/union_council_name"
                    android:maxLines="1"
                    android:digits="@string/digits_str_num"
                    android:imeOptions="actionNext"/>
                <EditText
                    android:textSize="@dimen/textview_text_size"
                    android:id="@+id/village_name"
                    android:background="@drawable/edit_text_bg"
                    android:visibility="gone"
                    android:nextFocusDown="@+id/sp_networks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="@string/village_name"
                    android:maxLines="1"
                    android:digits="@string/digits_str_num"
                    android:imeOptions="actionNext"/>
                <Spinner
                    android:id="@+id/sp_networks"
                    android:background="@drawable/spinner_bg"
                    android:nextFocusDown="@+id/mobile_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"/>
                <EditText
                    android:textSize="@dimen/textview_text_size"
                    android:id="@+id/mobile_number"
                    android:background="@drawable/edit_text_bg"
                    android:nextFocusDown="@+id/mobile_number_repeat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="@string/mobile_number"
                    android:maxLines="1"
                    android:maxLength="@integer/phone_number_length"
                    android:digits="0123456789"
                    android:inputType="numberPassword"
                    android:imeOptions="actionNext"/>
                <EditText
                    android:textSize="@dimen/textview_text_size"
                    android:id="@+id/mobile_number_repeat"
                    android:background="@drawable/edit_text_bg"
                    android:nextFocusDown="@+id/alternative_contact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="@string/mobile_number_repeat"
                    android:maxLines="1"
                    android:maxLength="@integer/phone_number_length"
                    android:digits="0123456789"
                    android:inputType="numberPassword"
                    android:imeOptions="actionDone"/>
                <EditText
                    android:textSize="@dimen/textview_text_size"
                    android:id="@+id/alternative_contact"
                    android:background="@drawable/edit_text_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:hint="@string/alternative_contact"
                    android:maxLines="1"
                    android:maxLength="@integer/phone_number_length"
                    android:digits="0123456789"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionDone"/>
                <Spinner
                    android:id="@+id/sp_mother_language"
                    android:background="@drawable/spinner_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="right"
                        android:id="@+id/tvVenueLabel"
                        android:paddingBottom="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="یہ سروے کہاں پُر کیا جا رہا ہے؟"
                        android:fontFamily="@font/jameel_noori_nastaleeq"/>
                    <Spinner
                        android:id="@+id/spinnerVenue"
                        android:background="@drawable/spinner_bg"
                        android:padding="15dp"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:spinnerMode="dropdown"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_is_bisp_benif"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp">
                    <TextView
                        android:textSize="@dimen/textview_text_size"
                        android:layout_gravity="center_vertical"
                        android:paddingRight="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/question_bisp_benificiary"/>
                    <RadioGroup
                        android:orientation="horizontal"
                        android:id="@+id/rg_bispBenificiary"
                        android:paddingRight="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <RadioButton
                            android:textSize="@dimen/textview_text_size"
                            android:id="@+id/rb_bispBenificiary_yes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:text="@string/yes"
                            android:buttonTint="@color/colorButtonGreen"/>
                        <RadioButton
                            android:textSize="@dimen/textview_text_size"
                            android:id="@+id/rb_bispBenificiary_no"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:text="@string/no"
                            android:buttonTint="@color/colorButtonRed"/>
                    </RadioGroup>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_roster_count"
                    android:paddingTop="10dp"
                    android:paddingRight="5dp"
                    android:paddingBottom="5dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp">
                    <TextView
                        android:textSize="@dimen/textview_text_size"
                        android:paddingBottom="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/number_of_roster"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <EditText
                            android:textSize="@dimen/textview_text_size"
                            android:id="@+id/number_of_roster"
                            android:background="@drawable/edit_text_bg"
                            android:paddingLeft="@dimen/text_padding"
                            android:paddingRight="@dimen/text_padding"
                            android:focusable="false"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="5dp"
                            android:text="1"
                            android:hint="@string/number_of_roster"
                            android:maxLength="3"
                            android:digits="@string/digits"
                            android:layout_weight="1"
                            android:inputType="none"/>
                        <ImageView
                            android:id="@+id/iv_add_member"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_margin="5dp"
                            android:src="@drawable/ic_add"/>
                        <ImageView
                            android:id="@+id/iv_delete_member"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_margin="5dp"
                            android:src="@drawable/ic_minus"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <EditText
                android:textSize="@dimen/textview_text_size"
                android:id="@+id/reason"
                android:background="@drawable/edit_text_bg"
                android:visibility="gone"
                android:nextFocusDown="@+id/address_of_house"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:hint="@string/reason"
                android:maxLines="1"
                android:singleLine="true"
                android:maxLength="300"
                android:digits="@string/digits"
                android:inputType="textPersonName"
                android:imeOptions="actionNext"/>
            <ImageView
                android:id="@+id/imgbtn_household"
                android:visibility="gone"
                android:layout_width="@dimen/image_dimension"
                android:layout_height="@dimen/image_dimension"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
