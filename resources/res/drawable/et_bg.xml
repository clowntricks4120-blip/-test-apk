<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true">
        <layer-list>
            <item>
                <shape
                    android:shape="rectangle"
                    android:thickness="0dp">
                    <stroke
                        android:width="1dp"
                        android:color="#818285"/>
                    <solid android:color="@color/white"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_enabled="false">
        <layer-list>
            <item>
                <shape
                    android:shape="rectangle"
                    android:thickness="0dp">
                    <stroke
                        android:width="1dp"
                        android:color="#818285"/>
                    <solid android:color="#818285"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape
                    android:shape="rectangle"
                    android:thickness="0dp">
                    <stroke
                        android:width="1dp"
                        android:color="#818285"/>
                    <solid android:color="@color/white"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
